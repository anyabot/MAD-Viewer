{"chats":{"2401":{"chat":[{"k":"msg","t":"저기….","n":"아로네","c":"CH0024","u":1},{"k":"msg","t":"혹시 조금 이상한 의뢰도 받나요?","n":"아로네","c":"CH0024","u":1},{"k":"reply","o":["이상한 의뢰?"]},{"k":"msg","t":"예를 들면… 친구가 되어달라거나…","n":"아로네","c":"CH0024","u":1},{"k":"reply","o":["흠 뭐 안 되는 건 아닌데"]},{"k":"reply","o":["기간은?"]},{"k":"msg","t":"아","n":"아로네","c":"CH0024","u":1},{"k":"msg","t":"그러면 하루만…","n":"아로네","c":"CH0024","u":1},{"k":"msg","t":"돈을 얼마나 드려야 할지 몰라서요","n":"아로네","c":"CH0024","u":1},{"k":"msg","t":"실례가 됐다면 죄송합니다!","n":"아로네","c":"CH0024","u":1},{"k":"reply","o":["일단 만나서 얘기할까?"]},{"k":"reply","o":["지금 어디냐"]},{"k":"msg","t":"네?","n":"아로네","c":"CH0024","u":1},{"k":"msg","t":"이쪽으로 오시려고요?","n":"아로네","c":"CH0024","u":1},{"k":"reply","o":["그게 훨씬 편하잖아"]},{"k":"reply","o":["갈 테니까 위치만 보내놔"]},{"k":"msg","t":"ㅁㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇㅇ","n":"아로네","c":"CH0024","u":1},{"k":"reply","o":["?"]},{"k":"story"},{"k":"msg","t":"죄송해요…","n":"아로네","c":"CH0024"},{"k":"msg","t":"보드게임에 관한 얘기만 나오면 저도 모르게 폭주해 버려서…","n":"아로네","c":"CH0024"},{"k":"reply","o":["뭐 나름 재밌었어"]},{"k":"reply","o":["처음에는 좀 놀라긴 했다만"]},{"k":"msg","t":"다행이에요…","n":"아로네","c":"CH0024"},{"k":"msg","t":"저…","n":"아로네","c":"CH0024"},{"k":"msg","t":"혹시 다음에 또 연락해도 괜찮을까요?","n":"아로네","c":"CH0024"},{"k":"msg","t":"또 같이 보드게임하고 싶어서…","n":"아로네","c":"CH0024"},{"k":"reply","o":["그래 안 바쁠 때라면야 뭐"]},{"k":"msg","t":"네! 감사합니다!","n":"아로네","c":"CH0024"}],"story":[{"k":"text","lines":[{"k":"place","t":"베르몬트 거리"},{"k":"line","t":"여기 어디라고 한 것 같은데…","n":"나"},{"k":"line","t":"…어디 있다는 거야?","n":"나"},{"k":"line","t":"흐우우우… 어, 어떡하지이…","n":"???","c":"CH0024"},{"k":"line","t":"?","n":"나"},{"k":"line","t":"(어디서 이상한 소리가 들리는데…)","n":"나"},{"k":"line","t":"오늘 처음 알게 된 사람이랑… 바, 바로 만나야 한다니이….","n":"???","c":"CH0024"},{"k":"line","t":"……?","n":"???","c":"CH0024"},{"k":"line","t":"히이잉, 곧 약속한 시간인데에…","n":"???","c":"CH0024"},{"k":"line","t":"…….","n":"???","c":"CH0024"},{"k":"line","t":"이, 이쁜아… 어떡하지…?","n":"???","c":"CH0024"},{"k":"line","t":"역시 지금이라도 취소하고 수수료를 드리는 게―","n":"???","c":"CH0024"},{"k":"line","t":"손들엇!!!","n":"나"},{"k":"line","t":"히야아아아악!!!!","n":"???","c":"CH0024"},{"k":"line","t":"어?? 잠― 크아아아악!!","n":"나"},{"k":"narration","t":"(잠시 후)"},{"k":"line","t":"죄송해요! 죄송해요! 살아 있어서 죄송해요!","n":"???","c":"CH0024"},{"k":"line","t":"아니, 아직 아무 말도 안 했는―","n":"나"},{"k":"line","t":"이번 일은 가진 돈 전부를 드릴 테니 부디 용서해주세요!","n":"???","c":"CH0024"},{"k":"line","t":"음, 그래. 태도가 아주 바르군. 용서하마.","n":"나"},{"k":"line","t":"…네, 네에? 태도, 요…?","n":"???","c":"CH0024"},{"k":"line","t":"뭐, 농담이다. 따지자면 내가 원인을 제공한 거니까….","n":"나"},{"k":"line","t":"아무튼, 네가 아로네 맞지?","n":"나"},{"k":"line","t":"네에… 마, 맞아요….","n":"???","c":"CH0024"},{"k":"line","t":"{player} 님… 이시죠? 제 의뢰를 받아주신….","n":"???","c":"CH0024"},{"k":"line","t":"여, 여기까지 오시게 해서 정말 죄송하지만…","n":"???","c":"CH0024"},{"k":"line","t":"의뢰는 없던 일로 해주실 수 있을까요…?","n":"???","c":"CH0024"},{"k":"line","t":"엉? 갑자기?","n":"나"},{"k":"line","t":"역시 저 같은 게 너무 주제넘은 건가 해서….","n":"???","c":"CH0024"},{"k":"line","t":"그, 그리고 냉정히 생각해보니 {player} 님에 대한 예의도 아닌 것 같아서어…","n":"???","c":"CH0024"},{"k":"line","t":"무, 물론 수수료도 낼 테니까요!","n":"???","c":"CH0024"},{"k":"line","t":"…아앗! 그, 그러면 돈을 더 준비해야 하는데에….","n":"???","c":"CH0024"},{"k":"line","t":"잠깐, 그 전에 궁금한 게 있는데.","n":"나"},{"k":"line","t":"애초에 왜 친구가 되어달라고 의뢰까지 한 거냐?","n":"나"},{"k":"line","t":"네? 그, 그건…","n":"???","c":"CH0024"},{"k":"line","t":"친구랑 둘이… 보, 보드게임하면서 놀고 싶어서….","n":"???","c":"CH0024"},{"k":"line","t":"흠.","n":"나"},{"k":"line","t":"뭐, 알겠다. 그럼 의뢰는 없던 걸로.","n":"나"},{"k":"line","t":"네, 네에… 저, 정말 죄송했습니다….","n":"???","c":"CH0024"},{"k":"line","t":"그래, 그럼 이제 보드게임이나 하자고.","n":"나"},{"k":"line","t":"네, 네에… 그럼 바로 입금을―","n":"???","c":"CH0024"},{"k":"line","t":"네? 저, 저기… 바, 방금 뭐라고…?","n":"???","c":"CH0024"},{"k":"line","t":"보드게임하면서 놀고 싶다며.","n":"나"},{"k":"line","t":"하자고, 보드게임.","n":"나"},{"k":"line","t":"……저, 정말요?","n":"???","c":"CH0024"},{"k":"line","t":"정말 같이 놀아주시는 건가요? 보드게임하면서…?","n":"???","c":"CH0024"},{"k":"line","t":"기왕 여기까지 왔는데 몇 판 정도야 뭐 어때.","n":"나"},{"k":"line","t":"네저보드게임진짜진짜좋아하거든요","n":"???","c":"CH0024"},{"k":"line","t":"그런데같이할사람이없어서못하고있었던거고요","n":"???","c":"CH0024"},{"k":"line","t":"엄마나언니들은가끔같이어울려주긴하지만","n":"???","c":"CH0024"},{"k":"line","t":"다들너무바쁘니까매일부탁하는건미안해서","n":"???","c":"CH0024"},{"k":"line","t":"그래서늘보드게임을같이할친구가있었으면좋겠다고생각했는데","n":"???","c":"CH0024"},{"k":"line","t":"정말같이할수있는사람이생기다니꿈만같아요!","n":"???","c":"CH0024"},{"k":"line","t":"아, 음. 어어….","n":"나"},{"k":"line","t":"좋아하는보드게임은있으신가요?","n":"???","c":"CH0024"},{"k":"line","t":"주사위게임?","n":"???","c":"CH0024"},{"k":"line","t":"카드게임?","n":"???","c":"CH0024"},{"k":"line","t":"협력형?","n":"???","c":"CH0024"},{"k":"line","t":"대결형?","n":"???","c":"CH0024"},{"k":"line","t":"종류별로전부가지고있으니까말씀해주시면바로준비할게요","n":"???","c":"CH0024"},{"k":"line","t":"당장은없어도집에는있으니까일단말씀해보세요","n":"???","c":"CH0024"},{"k":"line","t":"이래봬도웬만한보드게임은전부가지고있다는자신하나만은있거든요!","n":"???","c":"CH0024"},{"k":"line","t":"그, 그래. 지금 여기서 할 만한 거 있냐…?","n":"나"},{"k":"line","t":"물론이죠! 바로 준비할게요!","n":"???","c":"CH0024"},{"k":"narration","t":"…그렇게 근처 카페에서 아로네와 보드게임을 하다 돌아왔다."}]}]},"2406":{"chat":[{"k":"msg","t":"안녕하세요 {player} 님","n":"아로네","c":"CH0024"},{"k":"msg","t":"저 같은 게 또 이런 부탁드리는 건 죄송하지만 혹시…","n":"아로네","c":"CH0024"},{"k":"msg","t":"오늘 같이 보드게임할 수 있으신가요…?","n":"아로네","c":"CH0024"},{"k":"reply","o":["그러지 뭐"]},{"k":"reply","o":["마침 시간도 비었고"]},{"k":"msg","t":"정말요…?","n":"아로네","c":"CH0024"},{"k":"reply","o":["어디로 가면 되냐?"]},{"k":"msg","t":"잠시만요!","n":"아로네","c":"CH0024"},{"k":"msg","t":"금방 장소랑 시간 정해서 알려드릴게요!","n":"아로네","c":"CH0024"},{"k":"story"}],"story":[{"k":"text","lines":[{"k":"line","t":"오, 오늘은 새로운 게임을 가져와 봤는데요오….","n":"아로네","c":"CH0024"},{"k":"line","t":"잠깐.","n":"나"},{"k":"line","t":"히이익-!","n":"아로네","c":"CH0024"},{"k":"line","t":"이 게임이 마음에 안 드는 건가요…?","n":"아로네","c":"CH0024"},{"k":"line","t":"아니, 그게 아니라… 여기 술집이잖아.","n":"나"},{"k":"place","t":"블러디 메리"},{"k":"line","t":"설마 싶지만 여기가 너희 집이냐?","n":"나"},{"k":"line","t":"아, 네에. 마, 맞아요.","n":"아로네","c":"CH0024"},{"k":"line","t":"원래 여기는 저희 저택 끝에 있는 방이었는데, 술집으로 개조한 거거든요….","n":"아로네","c":"CH0024"},{"k":"line","t":"호, 혹시 저희 가게에 와보셨을 수도 있지만… 아마 저를 본 적은 없으실 거예요.","n":"아로네","c":"CH0024"},{"k":"line","t":"사람이 많을 때는 방에서 잘 안 나오거든요….","n":"아로네","c":"CH0024"},{"k":"line","t":"하기야 그렇겠지.","n":"나"},{"k":"line","t":"그럼 왜 여기로 부른 거냐? 네 방으로 가도 되잖아.","n":"나"},{"k":"line","t":"네, 네에에?!!","n":"아로네","c":"CH0024"},{"k":"line","t":"…그, 그건 아직 너무 이른 것 같은데에….","n":"아로네","c":"CH0024"},{"k":"line","t":"……마, 마음의 준비가 끝나면! 그, 그때 초대 드릴게요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"뭐, 그러든가.","n":"나"},{"k":"line","t":"휴우….","n":"아로네","c":"CH0024"},{"k":"line","t":"그, 그럼 일단 이번에 준비한 게임을 설명해 드릴게요.","n":"아로네","c":"CH0024"},{"k":"line","t":"이번 판도 제가 이겼어요!","n":"아로네","c":"CH0024"},{"k":"line","t":"실력이 상당하네.","n":"나"},{"k":"line","t":"자랑은 아니지만, 보드게임이라면 자신 있거든요.","n":"아로네","c":"CH0024"},{"k":"line","t":"매일 집에서 하고 있으니까요.","n":"아로네","c":"CH0024"},{"k":"line","t":"…….","n":"아로네","c":"CH0024"},{"k":"line","t":"…혼자서.","n":"아로네","c":"CH0024"},{"k":"line","t":"…크흠.","n":"나"},{"k":"line","t":"혼자서도 즐길 수 있으면 오히려 대단한 거지.","n":"나"},{"k":"line","t":"저, 저기!","n":"아로네","c":"CH0024"},{"k":"line","t":"갑자기 이런 질문을 드리는 게 좀 이상한 건 알지만….","n":"아로네","c":"CH0024"},{"k":"line","t":"왜, 왜 저랑 같이 보드게임을 해주시는 건가요?","n":"아로네","c":"CH0024"},{"k":"line","t":"엉?","n":"나"},{"k":"line","t":"무, 물론 {player} 님이랑 하는 게 저는 엄청엄청 즐겁고 매일매일이 기대되는데….","n":"아로네","c":"CH0024"},{"k":"line","t":"{player} 님 입장에서는 별로 재미없으실 것 같아서…","n":"아로네","c":"CH0024"},{"k":"line","t":"매번 저만 이기니까… 이, 일부러 지는 건 예의가 아닐 것 같고….","n":"아로네","c":"CH0024"},{"k":"line","t":"이기는 게 재미있긴 하지만…","n":"나"},{"k":"line","t":"꼭 이겨야만 재밌는 건 아니잖아.","n":"나"},{"k":"line","t":"그, 그런 건가요…?","n":"아로네","c":"CH0024"},{"k":"line","t":"저, 저는 져본 적이 거의 없어서 잘 모르겠는데….","n":"아로네","c":"CH0024"},{"k":"line","t":"(이 자식이?)","n":"나"},{"k":"line","t":"물론 다른 사람이랑 보드게임을 해본 적이 많지는 않지만…","n":"아로네","c":"CH0024"},{"k":"line","t":"그래도… 저, 정말 {player} 님도 재미있으시긴 한 건지…","n":"아로네","c":"CH0024"},{"k":"line","t":"저 때문에 괜히 재미없는데… 이, 일부러 신경 써주시는 게 아닐까, 그런 게 걱정이라서….","n":"아로네","c":"CH0024"},{"k":"line","t":"그런 거 신경 쓸 필요 없어.","n":"나"},{"k":"line","t":"재미없으면 애초에 얼씬도 안 했을 거라고.","n":"나"},{"k":"line","t":"그, 그런가요오….","n":"아로네","c":"CH0024"},{"k":"line","t":"흠, 그게 그렇게 신경 쓰인다면…","n":"나"},{"k":"line","t":"다음에는 내 방식대로 좀 해볼까?","n":"나"},{"k":"line","t":"……네, 네에?","n":"아로네","c":"CH0024"}]}]},"2412":{"chat":[{"k":"msg","t":"안녕하세요 {player} 님","n":"아로네","c":"CH0024"},{"k":"msg","t":"오늘 같이 보드게임하기로 한 약속 기억하시나요?","n":"아로네","c":"CH0024"},{"k":"reply","o":["지금 가는 중이야"]},{"k":"msg","t":"네!","n":"아로네","c":"CH0024"},{"k":"msg","t":"저번에 말씀하셨던 대로…","n":"아로네","c":"CH0024"},{"k":"msg","t":"오늘은 뭔가 특별한 방식을 추가하는 거죠?","n":"아로네","c":"CH0024"},{"k":"msg","t":"너무 기대돼요!","n":"아로네","c":"CH0024"},{"k":"story"}],"story":[{"k":"text","lines":[{"k":"place","t":"블러디 메리"},{"k":"line","t":"…아!","n":"아로네","c":"CH0024"},{"k":"line","t":"어, 어서 오세요. 에헤헤…!","n":"아로네","c":"CH0024"},{"k":"line","t":"말씀하신 대로 준비는 다 해뒀어요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그래, 마음의 준비도 끝났냐?","n":"나"},{"k":"line","t":"마, 마음의 준비요…?","n":"아로네","c":"CH0024"},{"k":"line","t":"네, 네에. 잘은 모르겠지만… 그, 그것도 끝난 것 같아요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"그럼 가자고.","n":"나"},{"k":"line","t":"오늘은 네 방에서 하는 거지?","n":"나"},{"k":"line","t":"네!","n":"아로네","c":"CH0024"},{"k":"line","t":"…아! 그, 그 전에 말인데요.","n":"아로네","c":"CH0024"},{"k":"line","t":"저번에 {player} 님이 말씀하신 그 ‘방식’이란 거…","n":"아로네","c":"CH0024"},{"k":"line","t":"호, 혹시 미리 살짝 알려주실 수 있나 해서어….","n":"아로네","c":"CH0024"},{"k":"line","t":"계, 계속 물어보고 싶었는데! 오늘만 기다리면서 참았거든요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"뭐, 너무 기대하지는 말라고.","n":"나"},{"k":"line","t":"그냥 좀 특이한 룰을 추가하는 거야.","n":"나"},{"k":"line","t":"트, 특이한 룰…!","n":"아로네","c":"CH0024"},{"k":"line","t":"전에 살던 곳에서 유행하던 걸 그대로 가져온 것뿐이니까.","n":"나"},{"k":"line","t":"로, 로컬 룰이라는 거군요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그, 그래서 그 룰이란 건 뭔가요오…?!","n":"아로네","c":"CH0024"},{"k":"line","t":"진 사람은 이긴 사람의 소원을 무엇이든 하나 들어주는 거야.","n":"나"},{"k":"line","t":"소, 소원…!","n":"아로네","c":"CH0024"},{"k":"line","t":"……?","n":"아로네","c":"CH0024"},{"k":"line","t":"끄, 끝인가요?","n":"아로네","c":"CH0024"},{"k":"line","t":"응.","n":"나"},{"k":"line","t":"장르가 아예 달라진다거나 승리 플랜이 완전히 뒤바뀐다거나… 그, 그런 건 없나요?","n":"아로네","c":"CH0024"},{"k":"line","t":"없어. 말했잖아, 너무 기대하지 말라고.","n":"나"},{"k":"line","t":"아, 아하.","n":"아로네","c":"CH0024"},{"k":"line","t":"(…왠지 열받는데?)","n":"나"},{"k":"line","t":"…크흠, 뭐 아무튼 이런 룰이면 난 좀 더 재밌어진다고.","n":"나"},{"k":"line","t":"그, 그러시다면야….","n":"아로네","c":"CH0024"},{"k":"line","t":"……그, 그 소원 말인데요.","n":"아로네","c":"CH0024"},{"k":"line","t":"피망을 대신 먹어달라는 소원도 가능한가요…?","n":"아로네","c":"CH0024"},{"k":"line","t":"그럼.","n":"나"},{"k":"line","t":"…! 그, 그럼 엄청 구하기 힘든 보드게임을 구해 달라는 것도…?!","n":"아로네","c":"CH0024"},{"k":"line","t":"가능하지.","n":"나"},{"k":"line","t":"와, 와아…! 좀 더 재밌어진다는 말, 왠지 알 것 같아요!","n":"아로네","c":"CH0024"},{"k":"line","t":"어때? 소원 걸고 한판 해볼래?","n":"나"},{"k":"line","t":"그, 그럼 제 방으로 가요!","n":"아로네","c":"CH0024"},{"k":"line","t":"규칙은 가면서 설명해 드릴게요!","n":"아로네","c":"CH0024"}]},{"k":"scene","kind":"desire"},{"k":"text","lines":[{"k":"place","t":"아로네의 방"},{"k":"line","t":"제가 이겼어요!","n":"아로네","c":"CH0024"},{"k":"line","t":"이러면 제 소원을 들어주는 거 맞죠…?","n":"아로네","c":"CH0024"},{"k":"line","t":"(진짜 왜 이렇게 잘하지? 필살 판뒤집기까지 썼는데???)","n":"나"},{"k":"line","t":"그, 그래. 한 입으로 두말할 순 없지….","n":"나"},{"k":"line","t":"헤헤, 제 소원은요….","n":"아로네","c":"CH0024"},{"k":"line","t":"다음에도 여기서 저랑 같이 보드게임을 같이 해주시는 거예요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"…엉?","n":"나"},{"k":"line","t":"고작 그런 소원으로 괜찮겠냐?","n":"나"},{"k":"line","t":"저 같은 게 너무 큰 소원을 바라면 혼날 것 같고…","n":"아로네","c":"CH0024"},{"k":"line","t":"…다, 다른 사람이랑 즐겁게 보드게임을 할 수 있는 것만으로도 행복하거든요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그러니까 이 행복을, 조금이라도 더 오래 느끼고 싶어요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"…안될까요?","n":"아로네","c":"CH0024"},{"k":"line","t":"안될 리가.","n":"나"},{"k":"line","t":"그 정도는 들어줄 수 있지.","n":"나"},{"k":"line","t":"……에헤헤.","n":"아로네","c":"CH0024"},{"k":"line","t":"약속이에요?","n":"아로네","c":"CH0024"}]}]},"2416":{"chat":[{"k":"msg","t":"저기…","n":"아로네","c":"CH0024"},{"k":"msg","t":"내일 시간 괜찮으신가요?","n":"아로네","c":"CH0024"},{"k":"reply","o":["엉? 내일 보드게임 하는 날이었나?"]},{"k":"msg","t":"그건 아닌데…","n":"아로네","c":"CH0024"},{"k":"msg","t":"실은 중고 거래 사이트에서 꼭 사고 싶은 걸 발견해서요","n":"아로네","c":"CH0024"},{"k":"msg","t":"저도 모르게 예약 구매를 해버렸는데…","n":"아로네","c":"CH0024"},{"k":"msg","t":"연식이 엄청 오래된 보드게임이라고 해서 직거래를 하는 게 안전할 것 같거든요","n":"아로네","c":"CH0024"},{"k":"msg","t":"혹시 내일 같이 가주실 수 있나요…?","n":"아로네","c":"CH0024"},{"k":"reply","o":["잠깐만"]},{"k":"reply","o":["밖으로 나가겠다고? 네가?"]},{"k":"msg","t":"네…","n":"아로네","c":"CH0024"},{"k":"msg","t":"안될까요…?","n":"아로네","c":"CH0024"},{"k":"story"},{"k":"msg","t":"오늘 같이 가주셔서 정말 고맙습니다!","n":"아로네","c":"CH0024"},{"k":"msg","t":"덕분에 무사히 집까지 가져왔어요","n":"아로네","c":"CH0024"},{"k":"msg","t":"그 뒤로 설명서를 좀 더 읽어봤는데 재미있는 내용이 많더라고요","n":"아로네","c":"CH0024"},{"k":"msg","t":"결혼 카드를 사용한 부부인 플레이어들은 행동 커맨드에 제약이 생긴다든지","n":"아로네","c":"CH0024"},{"k":"reply","o":["그 보드게임, 너무 깊게 공부하지는 마라…"]}],"story":[{"k":"text","lines":[{"k":"place","t":"베르몬트 어딘가"},{"k":"line","t":"가, 감사합니닥…!","n":"아로네","c":"CH0024"},{"k":"line","t":"에헤헤…! 이것이 전설의 고대 보드게임, <뉴 패밀리 라이프>!","n":"아로네","c":"CH0024"},{"k":"line","t":"…저 녀석, 사기꾼 아니야?","n":"나"},{"k":"line","t":"보드게임이 아니라 그냥 폐기물을 주고 간 것 같은데.","n":"나"},{"k":"line","t":"거, 겉으로 보기에는 좀 낡긴 했지만…","n":"아로네","c":"CH0024"},{"k":"line","t":"수집가들조차 쉽게 구하지 못하는… 어, 엄청난 고대의 유물이라고요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그리고 중요한 건 내용물이니까요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"내용물도 똑같더만… 까딱 잘못하면 금방 부서질 것 같던데.","n":"나"},{"k":"line","t":"이래선 게임은 못 하는 거 아니야?","n":"나"},{"k":"line","t":"괘, 괜찮아요. 중요한 건 구성품이랑 게임판을 해석하는 거니까….","n":"아로네","c":"CH0024"},{"k":"line","t":"그걸 토대로 규칙을 추론해내기만 하면… 그, 그 다음엔 사본을 만들면 되거든요!","n":"아로네","c":"CH0024"},{"k":"line","t":"오, 그런 방법이.","n":"나"},{"k":"line","t":"에헤헤… 보, 보통 이런 오래된 보드게임들은 정보가 많이 없어서요.","n":"아로네","c":"CH0024"},{"k":"line","t":"설명서도 대부분 없고… 구성품이 빠져 있거나, 게임판 일부가 지워져 있는 게 많으니까…","n":"아로네","c":"CH0024"},{"k":"line","t":"그, 그런데 또 어떻게든 규칙을 만들어낼 수 있다는 게 보드게임의 매력이지만요!","n":"아로네","c":"CH0024"},{"k":"line","t":"…그런 게 가능한 건 너밖에 없을 것 같다만.","n":"나"},{"k":"line","t":"그래서, 지금은 뭐 하는 중인데?","n":"나"},{"k":"line","t":"아, 설명서를 읽고 있었는데… 자, 잘 모르겠어요.","n":"아로네","c":"CH0024"},{"k":"line","t":"이번에 구한 건 설명서가 포함되어 있다길래 운이 좋다고 생각했는데에…","n":"아로네","c":"CH0024"},{"k":"line","t":"히잉… 이, 이 게임에서 사용되는 용어가 특이해서 잘 모르겠다고 해야 할까….","n":"아로네","c":"CH0024"},{"k":"line","t":"뭔데 그래.","n":"나"},{"k":"line","t":"으음… 예, 예를 들면 플레이어들이 특정한 조건을 만족할 때 파티를 맺으면…","n":"아로네","c":"CH0024"},{"k":"line","t":"‘신혼’…? 이라는 특수 스테이터스가 부여된다든가….","n":"아로네","c":"CH0024"},{"k":"line","t":"신혼? 결혼 말이야?","n":"나"},{"k":"line","t":"겨, 결혼이요? 그건 어떤…","n":"아로네","c":"CH0024"},{"k":"line","t":"어… 서로 좋아하는 사람들이 끊을 수 없는 파티를 맺는 거? 대충 그런 느낌이야.","n":"나"},{"k":"line","t":"앗! 그, 그렇네요!","n":"아로네","c":"CH0024"},{"k":"line","t":"파티를 맺을 때 필요한 카드 이름이 ‘결혼’이에요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"{player} 님은 어, 어떻게 알고 계신 거예요?!","n":"아로네","c":"CH0024"},{"k":"line","t":"엉…? 아, 뭐…","n":"나"},{"k":"line","t":"전에 살던 곳에서 유행…? 하던 거긴 한데.","n":"나"},{"k":"line","t":"(…이 동네는 결혼 같은 개념도 없어?)","n":"나"},{"k":"line","t":"그, 그렇군요…! 역시 대단해요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그, 그럼! 이, 이것도 한번 봐주세요!","n":"아로네","c":"CH0024"},{"k":"line","t":"아까 그 ‘결혼’ 카드를 사용한 플레이어들이… ‘부부’라고 하는데요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"그럼 이 ‘아이를 갖는다’라는 게 최종 승리 조건인 것도 맞나요?!","n":"아로네","c":"CH0024"},{"k":"line","t":"이 조건을 달성하면 1,000포인트 추가… 엄청난 보너스 포인트를 주더라고요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"……어, 음. 뭐, 그건 잘 모르겠는데.","n":"나"},{"k":"line","t":"에헤헤, {player} 님도 모르는 게 있으셨군요.","n":"아로네","c":"CH0024"},{"k":"line","t":"거, 걱정 마세요! 제가 이 ‘아이를 갖는다’는 게 뭔지 확실히 알아낼 테니까요!","n":"아로네","c":"CH0024"},{"k":"line","t":"…혹시 이거 몰래카메라는 아니지?","n":"나"},{"k":"line","t":"네, 네에? 모, 몰래카메라…?","n":"아로네","c":"CH0024"},{"k":"line","t":"아니다….","n":"나"},{"k":"line","t":"그, 그런데 {player} 님… 아까부터 표정이 좀 안 좋으신 것 같은데에…","n":"아로네","c":"CH0024"},{"k":"line","t":"혹시 이 게임이 벼, 별로 마음에 들지 않으신가요…?","n":"아로네","c":"CH0024"},{"k":"line","t":"딱히 그런 건 아니고, 그냥 좀 신기해서.","n":"나"},{"k":"line","t":"……헤헤. 다, 다행이에요.","n":"아로네","c":"CH0024"},{"k":"line","t":"그러고 보니 시, 신기하긴 하네요. 이미 이 게임의 설정을 알고 계셨으니까….","n":"아로네","c":"CH0024"},{"k":"line","t":"시, 실은 이 <뉴 패밀리 라이프>를 산 것도 {player} 님이랑 같이 하려고 산 거거든요.","n":"아로네","c":"CH0024"},{"k":"line","t":"아, 그랬어?","n":"나"},{"k":"line","t":"그러니까 집에 돌아가면… 당장 분석을 시작할 거예요!","n":"아로네","c":"CH0024"},{"k":"line","t":"조, 조금 시간이 걸리긴 하겠지만 금방 공부해올 테니까요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그때는 저, 저랑 같이 또 보드게임 해주실 거죠…?","n":"아로네","c":"CH0024"},{"k":"line","t":"…그래그래. 알았다.","n":"나"},{"k":"line","t":"네 얘길 듣다가 뭔가 떠오른 게임이 있기도 하고.","n":"나"},{"k":"line","t":"저, 정말요?! 보드게임인가요? 이름이 뭐예요?","n":"아로네","c":"CH0024"},{"k":"line","t":"좀 생각이 정리되면 말해줄게.","n":"나"},{"k":"line","t":"일단 오늘은 돌아가자고.","n":"나"},{"k":"line","t":"에헤헤, 알겠습니다아…!","n":"아로네","c":"CH0024"},{"k":"line","t":"기다리고 있을게요!","n":"아로네","c":"CH0024"}]}]},"2420":{"chat":[{"k":"msg","t":"안녕하세요 {player} 님","n":"아로네","c":"CH0024"},{"k":"msg","t":"오늘 보드게임 약속도 너무 기대돼요","n":"아로네","c":"CH0024"},{"k":"reply","o":["아 맞다"]},{"k":"reply","o":["오늘 할 게임은 내가 준비해 갈게"]},{"k":"msg","t":"와아! 정말요?","n":"아로네","c":"CH0024"},{"k":"msg","t":"혹시 전에 말씀하셨던 그 게임인가요?","n":"아로네","c":"CH0024"},{"k":"reply","o":["글쎄다"]},{"k":"reply","o":["아무튼 기대하고 있으라고"]},{"k":"msg","t":"네!","n":"아로네","c":"CH0024"},{"k":"story"},{"k":"msg","t":"이번 게임은 너무 어려웠어요…","n":"아로네","c":"CH0024"},{"k":"msg","t":"제비에 적힌 대사가 무슨 뜻인지도 잘 모르겠고","n":"아로네","c":"CH0024"},{"k":"msg","t":"자꾸 {player} 님한테 부딪히기만 하고…","n":"아로네","c":"CH0024"},{"k":"msg","t":"게다가 진 것도 엄청 분해요","n":"아로네","c":"CH0024"},{"k":"reply","o":["그렇게 점점 성장하는 거지"]},{"k":"reply","o":["그래도 재밌었지?"]},{"k":"msg","t":"네! 재밌긴 했어요!","n":"아로네","c":"CH0024"},{"k":"msg","t":"꼭 이겨야만 재밌는 게 아니라는 말이 이런 뜻이었군요","n":"아로네","c":"CH0024"},{"k":"reply","o":["다음에 또 하고 싶으면 말하라고"]},{"k":"reply","o":["아니 이렇게 된 거 그냥 내일 또 한 번 할까?"]},{"k":"msg","t":"한동안은 좀 봐주시면…","n":"아로네","c":"CH0024"}],"story":[{"k":"text","lines":[{"k":"line","t":"(저번에는 졌지만… 오늘은 다르다.)","n":"나"},{"k":"line","t":"(‘이거’라면, 아무리 아로네라도 쉽지 않을 테니까.)","n":"나"},{"k":"place","t":"블러디 메리"},{"k":"line","t":"아, 안녕하세요!","n":"아로네","c":"CH0024"},{"k":"line","t":"에헤헤… {player} 님이 준비해오신 보드게임…!","n":"아로네","c":"CH0024"},{"k":"line","t":"너무너무 기대서 아까부터 가만히 있질 못하겠어요!","n":"아로네","c":"CH0024"},{"k":"line","t":"그래, 이번에도 전에 살던 곳에서 유행하던 걸 가져왔지.","n":"나"},{"k":"line","t":"대, 대단해요!","n":"아로네","c":"CH0024"},{"k":"line","t":"{player} 님이 전에 살던 곳은 없는 게 없나 보네요…!","n":"아로네","c":"CH0024"},{"k":"line","t":"그, 그럼 바로 제 방으로 갈까요?","n":"아로네","c":"CH0024"},{"k":"line","t":"잠깐. 그 전에, 이거 받아.","n":"나"},{"k":"line","t":"네, 네에?","n":"아로네","c":"CH0024"},{"k":"line","t":"…이, 이게 뭔가요?","n":"아로네","c":"CH0024"},{"k":"line","t":"룰렛이랑, 제비뽑기랑… 설명서?","n":"아로네","c":"CH0024"},{"k":"line","t":"이번엔 사전 지식이 좀 필요하거든.","n":"나"},{"k":"line","t":"쉽게 말해, 손과 발을 정해진 자리에 두고 역할극을 하는 건데…","n":"나"},{"k":"line","t":"…규, 규칙은 어느 정도 이해했어요.","n":"아로네","c":"CH0024"},{"k":"line","t":"헤헤, 그리고 <뉴 패밀리 라이프>에 나오는 설정을 섞은 거군요?","n":"아로네","c":"CH0024"},{"k":"line","t":"뭐 그렇지.","n":"나"},{"k":"line","t":"{player} 님은 정말 대단하세요! 이런 재밌어 보이는 게임을 생각해내시다니…!","n":"아로네","c":"CH0024"},{"k":"line","t":"그, 그런데 손과 발을 이리저리 움직여야 한다니…","n":"아로네","c":"CH0024"},{"k":"line","t":"흐우우… 저 완전 몸치인데에….","n":"아로네","c":"CH0024"},{"k":"line","t":"이런 것에도 도전해봐야지.","n":"나"},{"k":"line","t":"언제 어떤 보드게임을 하게 될지 모르잖아.","n":"나"},{"k":"line","t":"우으으… 그, 그럼 한 번 해볼까요.","n":"아로네","c":"CH0024"},{"k":"line","t":"움직일 수 있는 공간 자체는… 응, 그럭저럭 넓으니까…","n":"아로네","c":"CH0024"},{"k":"line","t":"아, 말하는 걸 깜빡한 것 같은데 판 위에는 나도 같이 올라간다?","n":"나"},{"k":"line","t":"서로 번갈아 가면서 하는 거거든.","n":"나"},{"k":"line","t":"…….","n":"아로네","c":"CH0024"},{"k":"line","t":"에에에에!!??","n":"아로네","c":"CH0024"}]},{"k":"scene","kind":"affection"}]}}}
