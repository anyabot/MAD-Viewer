{"chats":{"201":{"chat":[{"k":"system","t":"[Web 발신] 제 1회 도넛 하우스배 도넛 시식회에 당신을 초대합니다!"},{"k":"system","t":"메시지에 답장하면 담당자가 직접 연락드립니다!"},{"k":"reply","o":["도넛이라…","관심 있음"]},{"k":"msg","t":"안녕하세요오!","n":"라일라","c":"CH0002"},{"k":"msg","t":"맛있는 도넛 소개해 드리려고 왔어욧!","n":"라일라","c":"CH0002"},{"k":"reply","o":["누가 만든 도넛인데?"]},{"k":"msg","t":"일단 제가 만든 도넛인데요오…","n":"라일라","c":"CH0002"},{"k":"msg","t":"…안, 안 되는 건가요?","n":"라일라","c":"CH0002"},{"k":"reply","o":["?","그래서 어디라고?"]},{"k":"reply","o":["미소녀의 수제 도넛은 놓칠 수 없지"]},{"k":"msg","t":"미, 미소녀인진 모르겠지만…!","n":"라일라","c":"CH0002"},{"k":"msg","t":"열심히 만들었는데… 그, 혹시 바쁘시지 않다면 여기로 나와 주세요!","n":"라일라","c":"CH0002"},{"k":"story"},{"k":"msg","t":"저, 저기…!","n":"라일라","c":"CH0002"},{"k":"msg","t":"내일도 행사하니까, 꼭 다시 와 주세요!","n":"라일라","c":"CH0002"},{"k":"reply","o":["아니, 그래서 내 번호는 어떻게 알아냈는데?"]},{"k":"msg","t":"도넛 하우스 회원 카드 등록하셨던데요오…","n":"라일라","c":"CH0002"},{"k":"reply","o":["경찰이 선량한 시민의 번호로 사적인 접근을 해도 되는 거야?"]},{"k":"msg","t":"저… 그 선량한 시민이라는 말은 좀 틀린 것 같, 같은데요오","n":"라일라","c":"CH0002"},{"k":"reply","o":["아무튼, 경찰에 신고할 거야"]},{"k":"msg","t":"네? 저희한테 신고한다고요오…?","n":"라일라","c":"CH0002"}],"story":[{"k":"text","lines":[{"k":"place","t":"도넛 하우스"},{"k":"narration","t":"당장 집에 간식이 없기도 해서, 겸사겸사 도넛 시식회에 가 보기로 했다."},{"k":"line","t":"그러고 보니 모찌톡의 그 얼굴… 어디서 본 것 같단 말이야.","n":"나"},{"k":"line","t":"?","n":"나"},{"k":"narration","t":"시식회에 도착했는데, 있으면 안 될 것이 테이블에 놓여 있었다."},{"k":"line","t":"잠깐만, 이게 뭐야! 웬 똥이 그릇 위에 올라가 있어!!","n":"나"},{"k":"line","t":"또, 똥이 아니라 도넛인데요오…","n":"???","c":"CH0002"},{"k":"line","t":"…도넛이라고?!","n":"나"},{"k":"narration","t":"이 말도 안 되는 소리를 대체 누가 하는지, 그 얼굴이나 좀 봐야겠다."},{"k":"line","t":"(이 얼굴, 묘하게 익숙한데.)","n":"나"},{"k":"line","t":"그, 그렇게 빤히 보시면... 부, 부끄럽다고요오...","n":"라일라","c":"CH0002"},{"k":"line","t":"아, 너는!","n":"나"},{"k":"line","t":"아! 다, 당신은!","n":"라일라","c":"CH0002"},{"k":"line","t":"그때 그 경찰!","n":"나"},{"k":"line","t":"그때 그 타, 탈옥수!","n":"라일라","c":"CH0002"},{"k":"line","t":"아아!","n":"라일라","c":"CH0002"},{"k":"line","t":"노, 놓치지 않겠어요오! 저에게 모, 못 보여줄 것 보여주고, 협박하고, 납치하고…!!","n":"라일라","c":"CH0002"},{"k":"place","t":"뒷골목"},{"k":"line","t":"윽!","n":"나"},{"k":"line","t":"머, 멈춰! 폭력 반대!","n":"나"},{"k":"line","t":"시, 시끄러워요!!","n":"라일라","c":"CH0002"},{"k":"line","t":"지, 진정하시고...","n":"라일라","c":"CH0002"},{"k":"line","t":"이거 좀 드셔보세요오!","n":"라일라","c":"CH0002"},{"k":"narration","t":"그렇게 아까 봤던 강렬한 비쥬얼의 물건이 담긴 그릇이 얼굴에 쳐 박혔다."},{"k":"line","t":"(크윽, 이대로 죽는 건가…)","n":"나"},{"k":"line","t":"(그런데 잠깐만, 이거 꽤 맛있는데?)","n":"나"},{"k":"line","t":"(진짜 도넛이었잖아? 왜 하필 비쥬얼이…우욱.)","n":"나"},{"k":"line","t":"잠, 잠시 이쪽으로 모시겠습니다아!","n":"라일라","c":"CH0002"},{"k":"line","t":"휴우... 그래서, 날 부른 이유는 뭔데?","n":"나"},{"k":"line","t":"내가 그때 파노티콘에서 대량으로 도넛 사준다는 약속은 못 지켰어도 도넛 하우스 단골은 됐잖아.","n":"나"},{"k":"line","t":"3월 17일 빵집 절도 미수... 5월 2일 편의점 라면 무전 취식.","n":"라일라","c":"CH0002"},{"k":"line","t":"저, 저희 도넛 하우스 전산에 '지갑 텅텅 상습범'으로 등록되어 있으신데요오.","n":"라일라","c":"CH0002"},{"k":"line","t":"그, 그리고 단골은 되셨다지만 매번 시식용 도넛만 잔뜩 들고 가시고오…","n":"라일라","c":"CH0002"},{"k":"line","t":"(반박하고 싶은데 할 말이 없다.)","n":"나"},{"k":"line","t":"제, 제 도넛 평가만 해 주시면... 이 사소한 경범죄들 정도는 눈감아 드릴게요오…!","n":"라일라","c":"CH0002"},{"k":"choice","t":"네가? 왜?"},{"k":"line","t":"겨, 경찰도 바쁘다고요오… 더 큰 사건도 많은데 이런 작은 사건 일일 잡으러 다닐 수 없잖아요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"흐음… 뭐, 그건 그렇고. 갑자기 웬 도넛 평가인데?","n":"나"},{"k":"line","t":"아, 아무도 제 도넛을 먹어줄 생각조차 안해줘서요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"다, 당신은 제게 빚이 있으니까… 제 부탁 하나쯤은 들어주실 수 있을 것 같아서…","n":"라일라","c":"CH0002"},{"k":"choice","t":"배고픈 사람 약점 잡아서 협박이냐?"},{"k":"choice","t":"나한테 평가를 맡기다니 용감하군."},{"k":"line","t":"…그래, 뭐. 내가 평가할 도넛이 뭔데?","n":"나"},{"k":"line","t":"사, 사실 아까 드신 거랑 같은 건데요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"내용물만 다르다랄까… 뭐랄까요오… 아하하…","n":"라일라","c":"CH0002"},{"k":"line","t":"아까 나한테 퍼먹인 똥을 말하는 거냐?! 그러니까 아무도 안 먹지!!","n":"나"},{"k":"line","t":"또, 똥이 아니에요! 제, 제가 이번에 대회를 위해 열심히 준비한 도넛이라고요오…!","n":"라일라","c":"CH0002"},{"k":"line","t":"똥처럼 생긴 도넛이라면 그거대로 또 문제라고.","n":"나"},{"k":"line","t":"미, 미학적으로는 아무런 문제가 없는데… 왜 다들 제 도넛을 외면할까요오…","n":"라일라","c":"CH0002"},{"k":"choice","t":"…진심으로 몰라서 하는 소리냐?"},{"k":"line","t":"만들고 싶었던 맛의 조화를 완벽히 구현하기 위해서는 이것밖에 없었거든요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"밤새 고민해서 생각해 낸 최선의 모양이었다고요오…","n":"라일라","c":"CH0002"},{"k":"choice","t":"이 정도면 범죄의 영역이다."},{"k":"choice","t":"정말… 아방가르드한 도넛이네."},{"k":"line","t":"한 입만 드셔 보시면! 분명 저의 진심을 느낄 거예요오! 네?","n":"라일라","c":"CH0002"},{"k":"line","t":"…","n":"나"},{"k":"line","t":"(아, 아무래도 말려드는 기분인데 이거…)","n":"나"},{"k":"place","t":"번화가"},{"k":"line","t":"맛, 맛있죠...? 맛에는 자신 있다고요...!","n":"라일라","c":"CH0002"},{"k":"line","t":"헉! 저 사람 똥 먹어!","n":"시민1","c":"NP0103"},{"k":"line","t":"쯧쯧, 얼마나 먹을 게 없었으면...","n":"시민2","c":"NP0502"},{"k":"line","t":"아, 급한 용무가 생각 나서! 얼른 가 봐야겠어!","n":"나"},{"k":"line","t":"앗! 어, 어디 가세요오...!","n":"라일라","c":"CH0002"},{"k":"narration","t":"그대로 있다가는 온 세상에 이상한 소문이 돌 것 같아서 후다닥 도망갔다."}]}]},"206":{"chat":[{"k":"msg","t":"안녕하세요!","n":"라일라","c":"CH0002"},{"k":"reply","o":["너랑 있으면 안녕할 수가 없어","또 무슨 험한 꼴을 당할 줄 알고"]},{"k":"reply","o":["이러다 거리에서 똥 먹는 사람이라고 소문나면 어떻게 할 건데"]},{"k":"msg","t":"그, 그게 아니고…","n":"라일라","c":"CH0002"},{"k":"msg","t":"오늘 오후에 또 시식회 2라운드가 열리는데, 와 주셨으면 해서요오!","n":"라일라","c":"CH0002"},{"k":"reply","o":["왜 자꾸 날 찾는 거야?"]},{"k":"msg","t":"이, 이번에는… 더 맛있는 도넛을 준비해 놨다고요!","n":"라일라","c":"CH0002"},{"k":"reply","o":["…또다시 똥을 먹이기만 해봐라"]},{"k":"msg","t":"아, 알겠어요오… 그리고 똥 아니라니까…","n":"라일라","c":"CH0002"},{"k":"reply","o":["현실을 직시해","그건 진짜 아무리 봐도 똥처럼 생겼으니까"]},{"k":"msg","t":"히잉…","n":"라일라","c":"CH0002"},{"k":"story"},{"k":"msg","t":"… {player} 님?","n":"라일라","c":"CH0002"},{"k":"msg","t":"아까 시식회에서 제 몸이 어떻다고…","n":"라일라","c":"CH0002"},{"k":"reply","o":["아무것도 아니야"]},{"k":"msg","t":"네…? 네에…","n":"라일라","c":"CH0002"},{"k":"reply","o":["아무튼, 그건 그렇고"]},{"k":"reply","o":["무슨 일인데 선량한 시민에게 연락을?"]},{"k":"msg","t":"아, 다른 게 아니라요오…","n":"라일라","c":"CH0002"},{"k":"msg","t":"내일이 도넛 시식회 마지막 날인데, 오실 거죠…?","n":"라일라","c":"CH0002"},{"k":"reply","o":["저번에는 똥, 오늘은 폭탄","이다음은 뭔지 좀 궁금해지는데"]},{"k":"msg","t":"똥도 폭탄도 아니라고요오…!!","n":"라일라","c":"CH0002"},{"k":"msg","t":"아, 아무튼! 그, 그건 내일 오시면 알려 드릴게요!","n":"라일라","c":"CH0002"}],"story":[{"k":"text","lines":[{"k":"place","t":"도넛 하우스"},{"k":"narration","t":"인간은 같은 실수를 반복한다더니, 또 여기로 왔다."},{"k":"line","t":"이건! 이번에 저희 도넛 하우스에서 준비한 신, 신제품이에요! 드셔보시겠어요오?","n":"라일라","c":"CH0002"},{"k":"line","t":"…야.","n":"나"},{"k":"line","t":"네에…?","n":"라일라","c":"CH0002"},{"k":"choice","t":"뭐야, 이 크고 검은 구체는."},{"k":"choice","t":"게다가 왜 도넛에 심지가 있는 건데?"},{"k":"line","t":"'존재와 폭발의 철학적 탐구'라는 도넛이에요오.","n":"라일라","c":"CH0002"},{"k":"choice","t":"제목부터 위험한 냄새가 나는데…"},{"k":"choice","t":"대체 그런 걸 왜 탐구하는 거야?"},{"k":"line","t":"맛, 맛있으니 꼭 드셔보세요오!","n":"라일라","c":"CH0002"},{"k":"line","t":"실존주의적 허무와 폭, 폭발적 쾌락을! 동시에 경험하게 해주는 유일무이한 도넛이랍니다아.","n":"라일라","c":"CH0002"},{"k":"line","t":"딱 봐도 폭탄이잖아, 이거.","n":"나"},{"k":"line","t":"경찰이 아니라 폭탄마였네. 당장 경찰에 신고해야겠어.","n":"나"},{"k":"line","t":"도, 도넛 맞아요오…! 그리고 저 폭탄마 아니에요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"경찰이라더니, 선량한 시민을 이렇게 도넛으로 괴롭혀도 되는 거냐고.","n":"나"},{"k":"line","t":"이래 보여도 도넛 하우스 최고의 걸, 걸작이라고욧…!","n":"라일라","c":"CH0002"},{"k":"line","t":"드, 드셔 보시면 바로 느끼실 거에요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"야, 야! 그릇 내려 - 우붓 - !!","n":"나"},{"k":"line","t":"으브! 이어에오 아에오 어이야? (읍! 이번에도 강제로 먹이냐?)","n":"나"},{"k":"line","t":"이어... 애 아이아아? (읍… 이거 꽤 맛있잖아?)","n":"나"},{"k":"line","t":"그죠? 심혈을 다해 만들었다고요오!","n":"라일라","c":"CH0002"},{"k":"line","t":"그런데… 왜 하필 폭탄 모양이냐고!","n":"나"},{"k":"line","t":"다양한 형태의 도넛을 만들어 봐야, 비로소 그 도넛의 본질이 뭔지 알 수 있는 법입니다아.","n":"라일라","c":"CH0002"},{"k":"line","t":"그게 아니고! 아니 심지어 도넛에서 연기까지 나잖아!","n":"나"},{"k":"line","t":"그, 그건…! 폭발의 형상을 구현하기 위한 정, 정교한 디테일입니다아. 안, 안전해요오!","n":"라일라","c":"CH0002"},{"k":"line","t":"아무튼!","n":"라일라","c":"CH0002"},{"k":"line","t":"오오, 도넛이 잔뜩… 자, 잠깐!! 이건 폭탄이잖아!!","n":"시민1","c":"NP0103"},{"k":"line","t":"터, 터지는 거 아냐?!","n":"시민2","c":"NP0502"},{"k":"line","t":"….","n":"나"},{"k":"line","t":"훗. 내가 나설 차례인가.","n":"나"},{"k":"line","t":"잠깐. 이 도넛, 보기보다 맛있다고?","n":"나"},{"k":"line","t":"뭐야, 그쪽은 누구야?","n":"시민1","c":"NP0103"},{"k":"line","t":"나로 말하자면…  후마니타스 최고의 도넛 평론가다!","n":"나"},{"k":"line","t":"후마니타스… 최고의… 도넛 평론가?","n":"시민2","c":"NP0502"},{"k":"line","t":"자, 다들 이 도넛을 맛 봐라! 인생을 바꾸는 맛이라고!","n":"나"},{"k":"line","t":"인생은 모르겠고, 연기가 나는 것 같은데…","n":"시민2","c":"NP0502"},{"k":"line","t":"그거 터질 것 같은데 빨리 내려놓고 도망쳐요…!!","n":"시민1","c":"NP0103"},{"k":"line","t":"안 터진다고~ 방금 하나 먹었는데 멀쩡하잖아?","n":"나"},{"k":"line","t":"터질 것 같은 건 도넛으로 다져진 이 녀석의 육덕진 고급 바디겠지.","n":"나"},{"k":"line","t":"네…네에?!?!?!?!?","n":"라일라","c":"CH0002"},{"k":"line","t":"으응…?","n":"나"},{"k":"line","t":"꺄아악! 터, 터졌어!","n":"시민1","c":"NP0103"},{"k":"line","t":"안, 안 터진다더니!","n":"시민2","c":"NP0502"},{"k":"line","t":"아니, 이 사람 기절했어!","n":"시민1","c":"NP0103"},{"k":"line","t":"뭐야 안 터진다면서!","n":"나"},{"k":"line","t":"그럼 설마…","n":"나"},{"k":"line","t":"나도 터지는 건가…!!","n":"나"},{"k":"line","t":"다들 동작 그만! 손 들어!","n":"피트엔젤스비당","c":"NP0203"},{"k":"line","t":"여기 도넛 시식회라는 사특한 대회가 있다고 들어, 정의를 구현하기 위해 왔다!","n":"피트엔젤스비탄","c":"NP0212"},{"k":"line","t":"이제부터 이 도넛은…","n":"피트엔젤스비당","c":"NP0203"},{"k":"line","t":"전부 우리가 파괴한다!","n":"피트엔젤스비탄","c":"NP0212"},{"k":"line","t":"파, 파괴라니요! 제, 제가 있는 한 그럴 일은 없을 겁니다…!!!","n":"라일라","c":"CH0002"},{"k":"line","t":"패, 패배다!","n":"피트엔젤스비당","c":"NP0203"},{"k":"line","t":"도넛이 우리 근육을 이겨 버리다니…","n":"피트엔젤스비탄","c":"NP0212"},{"k":"line","t":"아직 끝나지 않았습니다아!","n":"라일라","c":"CH0002"},{"k":"line","t":"죄질이 매우 고약해요오…!","n":"라일라","c":"CH0002"},{"k":"line","t":"테, 테러범으로! 현행 체포합니다!","n":"라일라","c":"CH0002"},{"k":"line","t":"먹을 거로 장난친 대가로 엄벌을 받으셔야 할 거예요!","n":"라일라","c":"CH0002"},{"k":"line","t":"(역시 경찰은 경찰인가)","n":"나"},{"k":"line","t":"(근데 폭탄 도넛도 결국 먹을 걸로 장난치는 거 아닌가?)","n":"나"}]}]},"212":{"chat":[{"k":"msg","t":"오늘도 도넛 시식회에 참여해 주셔서 감사해요오…","n":"라일라","c":"CH0002"},{"k":"reply","o":["별것도 아니었는데, 뭐"]},{"k":"msg","t":"사실…저어…","n":"라일라","c":"CH0002"},{"k":"msg","t":"{player} 님께 여쭙고 싶은 게 있어요오","n":"라일라","c":"CH0002"},{"k":"msg","t":"후마니타스 최고의 도넛 평론가만 답할 수 있는 문제라서…","n":"라일라","c":"CH0002"},{"k":"reply","o":["아니 언제부터 진짜 도넛 평론가가 된 건데"]},{"k":"reply","o":["그런데 나만 답할 수 있는 문제?","까짓것 한번 해보지"]},{"k":"story"},{"k":"reply","o":["이봐"]},{"k":"reply","o":["네 안의 그것, 찾았어?"]},{"k":"msg","t":"네…! 찾은 것 같아요오!","n":"라일라","c":"CH0002"},{"k":"reply","o":["오! 어떻게 찾았는데?"]},{"k":"msg","t":"궁극의 도넛은 단순한 맛이나 모양을 말하는 게 아니었어요오","n":"라일라","c":"CH0002"},{"k":"msg","t":"사람의 본능을 자극하는 ‘느낌’...","n":"라일라","c":"CH0002"},{"k":"msg","t":"부드러운 감각의 응축, 순간의 짜릿함","n":"라일라","c":"CH0002"},{"k":"msg","t":"하아… 생각만 해도 다리가 후들거려요오","n":"라일라","c":"CH0002"},{"k":"reply","o":["곧 있으면 크림도 흐르겠군"]},{"k":"msg","t":"네?","n":"라일라","c":"CH0002"},{"k":"reply","o":["아무것도 아니야"]},{"k":"msg","t":"…???","n":"라일라","c":"CH0002"}],"story":[{"k":"text","lines":[{"k":"place","t":"뒷골목"},{"k":"line","t":"어제 저는 깨달았어요.","n":"라일라","c":"CH0002"},{"k":"line","t":"도넛의 본질을 파악하고, 과감하게 진리를 깨우치려는 자세도 중요하지만…","n":"라일라","c":"CH0002"},{"k":"line","t":"다, 다른 사람들의 눈길을 신경 쓰지 않고, 밀고 나가는 자신감도 중요하다고요…!!","n":"라일라","c":"CH0002"},{"k":"line","t":"(갑자기 무슨 소리야.)","n":"나"},{"k":"line","t":"아무튼, 묻고 싶다는 게 뭐야?","n":"나"},{"k":"line","t":"아, 그건 말이죠오.","n":"라일라","c":"CH0002"},{"k":"line","t":"저, 저는 요즘, 궁극의 도넛이란 무엇일까, 계속 고, 고민하고 있었거든요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"그래서! {player} 님의 의견을 묻고 싶습니다! 궁극의 도넛이란 무엇일까요오!","n":"라일라","c":"CH0002"},{"k":"line","t":"흠...","n":"나"},{"k":"line","t":"속살이 핑크빛인 도넛?","n":"나"},{"k":"line","t":"?","n":"라일라","c":"CH0002"},{"k":"line","t":"입으로, 혀로 촵촵 열심히 먹다 보면 가운데 기다란 틈에…","n":"나"},{"k":"line","t":"가, 가운데 틈에?!","n":"라일라","c":"CH0002"},{"k":"line","t":"촉촉하고 향긋한 우윳빛 크림이 흘러나오는 거야.","n":"나"},{"k":"line","t":"크림이 콧등까지 흘러내릴 정도로 잔뜩 차 있어야 진짜지.","n":"나"},{"k":"line","t":"그리고 구멍에… 혀를 넣어 보면 새콤한 맛이 묻어나는 거야.","n":"나"},{"k":"line","t":"그… 그런 도넛은! 생각지도 못했어요.","n":"라일라","c":"CH0002"},{"k":"line","t":"라일라, 너는 이미 그 도넛을 가지고 있어.","n":"나"},{"k":"line","t":"…네?!","n":"라일라","c":"CH0002"},{"k":"line","t":"여기, 제가 가지고 온 1,276개의 도넛 중에 그런 도넛이 있다고요?!","n":"라일라","c":"CH0002"},{"k":"choice","t":"(역시 사람은 자기가 가진 걸 모른다더니.)"},{"k":"choice","t":"(저 1,276개의 도넛 말고 다른 게 먹고 싶은데.)"},{"k":"line","t":"으음…","n":"라일라","c":"CH0002"},{"k":"line","t":"…역시, 그런 도넛이라면…","n":"라일라","c":"CH0002"},{"k":"line","t":"이… 글레이즈드 도넛이 가장 근접해보이네요오…","n":"라일라","c":"CH0002"},{"k":"line","t":"크, 크림은 없지만…! 반죽을 만들 때 딸기맛을 첨가해서 살짝 핑크빛이랍니다아…","n":"라일라","c":"CH0002"},{"k":"line","t":"…이게 바로, 최고의 도넛 평론가님이 말씀하시는 도, 도넛의 이데아!","n":"라일라","c":"CH0002"},{"k":"line","t":"모든 도넛 중에 가장 도넛다운 도넛… 그저 도넛이라는 단어가 떠오르는 가장 순수한 맛…!","n":"라일라","c":"CH0002"},{"k":"line","t":"하… 라일라, 그게 아니야.","n":"나"},{"k":"line","t":"네?","n":"라일라","c":"CH0002"},{"k":"line","t":"궁극의 도넛은, 이미 네 안에 존재해. 아주 깊숙하고 은밀한 곳에.","n":"나"},{"k":"line","t":"!!","n":"라일라","c":"CH0002"},{"k":"line","t":"제 안에… 이미 도넛의 이데아가?","n":"라일라","c":"CH0002"},{"k":"line","t":"그래.","n":"나"},{"k":"line","t":"역시… 실체가 없는 도, 도넛이군요!","n":"라일라","c":"CH0002"},{"k":"line","t":"아니야. 그 도넛에는 엄연히 실체가 있어.","n":"나"},{"k":"line","t":"엄, 엄청난 깨달음이에요오!","n":"라일라","c":"CH0002"},{"k":"line","t":"이미 제 안에 도넛의 이데아가 있다니…","n":"라일라","c":"CH0002"},{"k":"choice","t":"내가 도와주면 더욱 완벽한 도넛이 되겠지만 말이야."},{"k":"choice","t":"찾는 거, 내가 도와줄까?"},{"k":"line","t":"아니요! 괜, 괜찮아요오…!","n":"라일라","c":"CH0002"},{"k":"line","t":"엥?","n":"나"},{"k":"line","t":"이, 이미 많은 도움을 받았는데… 이 이상 폐를 끼, 끼치는 건 죄송해서…","n":"라일라","c":"CH0002"},{"k":"line","t":"제, 제 안의 도넛의 이데아는! 저 스스로 찾아볼게요오!","n":"라일라","c":"CH0002"},{"k":"line","t":"당, 당장 찾으러 가야겠어요!","n":"라일라","c":"CH0002"},{"k":"line","t":"…쳇.","n":"나"}]}]}}}
