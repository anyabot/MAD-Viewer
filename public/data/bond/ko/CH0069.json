:"line","t":"이런 백주대낮에 대로변에서 <bouten>전라</bouten>로 있는 사람을 알 리가 없다는 말이야!","n":"나"},{"k":"line","t":"뭣이!? 전라라고...?","n":"단희","c":"CH0020"},{"k":"line","t":"어딜 봐도 전라인 사람은 없다만?","n":"단희","c":"CH0020"},{"k":"line","t":"너 말이야, 너!","n":"나"},{"k":"line","t":"나...?","n":"단희","c":"CH0020"},{"k":"line","t":"실례로구나, 벗아. 제대로 옷을 입고 있지 않느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"그걸!","n":"나"},{"k":"line","t":"옷이라고!","n":"나"},{"k":"line","t":"할 수 있냐!!","n":"나"},{"k":"line","t":"나 원 참. 평소에는 가슴이니, 엉덩이니 하면서 겨우 이 정도 가지고.","n":"단희","c":"CH0020"},{"k":"line","t":"아니, 물론 나도 이런 건 좋아하지만... 본인이 당당해버리면 재미가 반감된다고.","n":"나"},{"k":"line","t":"원래 노출 플레이는 부끄러워하는 게 핵심인데??","n":"나"},{"k":"line","t":"호오~","n":"단희","c":"CH0020"},{"k":"line","t":"그러면 내가 아앙~♡ 부끄러워요~♡ 라고 해주면 되나?","n":"단희","c":"CH0020"},{"k":"line","t":"...애초에 네가 거기서 부끄러워할 위인이야?","n":"나"},{"k":"line","t":"하핫! 실로 그렇구나.","n":"단희","c":"CH0020"},{"k":"line","t":"하아... 아무튼, 무슨 일이야?","n":"나"},{"k":"line","t":"게다가 오늘 복장은 왜...","n":"나"},{"k":"line","t":"이거? 으음... 설명하자면 조금 긴데...","n":"단희","c":"CH0020"},{"k":"line","t":"짧고 굵게. 3줄 요약.","n":"나"},{"k":"line","t":"벗은 참 요약을 좋아하는구나.","n":"단희","c":"CH0020"},{"k":"line","t":"후후, 그러니까 이게 왜 이렇게 되었냐면...","n":"단희","c":"CH0020"},{"k":"line","t":"옛날 옛날에... 한 여자아이가 살았습니다.","n":"단희","c":"CH0020"},{"k":"line","t":"사기 치지 마라. 옛날도 아니고 아이도 아닌데.","n":"나"},{"k":"line","t":"에잇, 얌전히 듣지 못하겠느냐? 원래 옛 이야기엔 각색이 따르는 법이야.","n":"단희","c":"CH0020"},{"k":"line","t":"그걸 흔히 과거 미화라 하지. 아니, 미화라기보단 재창조 아냐?","n":"나"},{"k":"line","t":"...듣기 싫으면 안 들려줄 테다?","n":"단희","c":"CH0020"},{"k":"line","t":"...계속해 봐.","n":"나"},{"k":"line","t":"아무튼... 여자아이는 할로윈 축제의 분위기에 취해 객잔으로 들어왔어요.","n":"단희","c":"CH0020"},{"k":"line","t":"(분위기가 아니라 술에 취한 거겠지)","n":"나"},{"k":"line","t":"속마음으로 태클 금지니라.","n":"단희","c":"CH0020"},{"k":"line","t":"(씁...)","n":"나"},{"k":"line","t":"어허!","n":"단희","c":"CH0020"},{"k":"line","t":"에이 씨, 다 귀찮으니까 한 줄로 요약해!","n":"나"},{"k":"line","t":"나 참, 얄궂은 녀석. 알았다. 한 줄로 요약해 주마!","n":"단희","c":"CH0020"},{"k":"line","t":"그래서 여자아이는 무심코 객잔에 놓여있던 할로윈 봉납용 위령주를 다 마셔버리고 말았어요! 끝!","n":"단희","c":"CH0020"},{"k":"line","t":"...위령주? 무심코?","n":"나"},{"k":"line","t":"그렇지! 설마하니 객잔에 덩그러니 놓여있던 향기 좋은 술이 봉납용이었을 줄이야...","n":"단희","c":"CH0020"},{"k":"line","t":"일단 무심코는 아닌 거네. 아니, 애초에 본인이 산 것도 아닌 술을 마시면 안 되지?","n":"나"},{"k":"line","t":"나도 같은 생각이었단다! 그래서 살짝 혀끝만 대고 말 생각이었지.","n":"단희","c":"CH0020"},{"k":"line","t":"그런데...","n":"단희","c":"CH0020"},{"k":"line","t":"한 잔 들어 올리니 코에서 향기가 느껴지고.","n":"단희","c":"CH0020"},{"k":"line","t":"한 잔 기울이니 혀에서 풍미가 느껴지고.","n":"단희","c":"CH0020"},{"k":"line","t":"한 잔 들이켜니 가슴 속까지 씻어지는 듯하니...","n":"단희","c":"CH0020"},{"k":"line","t":"어찌 잔을 멈추겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"네 다음 알콜중독자~","n":"나"},{"k":"line","t":"매정한지고! 벗아, 너도 미주가이면서 이 마음을 모른단 말이냐?","n":"단희","c":"CH0020"},{"k":"line","t":"난 술이면 죽고 못사는 주정뱅이는 아니거든.","n":"나"},{"k":"line","t":"뭐, 좋아. 아무튼 이해했어. 그러니까...","n":"나"},{"k":"line","t":"객잔에 놓인 술을 마시고 곤드레만드레 취해버린 나머지 전라가 되었다는 말이지?","n":"나"},{"k":"line","t":"으응? 무슨 말이냐? 나는 옷을 벗었다고는 한마디도 안 했다만?","n":"단희","c":"CH0020"},{"k":"line","t":"...? 그럼 뭐야, 대체 뭐 때문에 그런 복장을 하고 있는 건데?","n":"나"},{"k":"line","t":"으음. 아무튼 그 후에 가문의 아이들이 나타나서...","n":"단희","c":"CH0020"},{"k":"line","t":"내가 마신 그 술은 일 년간 쌓인 부정한 힘을 정화하기 위한 술이다 라고 호들갑을 떨고...","n":"단희","c":"CH0020"},{"k":"line","t":"그 술이 아니면 부정한 힘이 날뛰어서 사군자가 난장판이 될 것이라 하니...","n":"단희","c":"CH0020"},{"k":"line","t":"어차피 술은 내가 마셔버렸으니 그것도 내가 같이 마셔버리면 될 것 아니냐! 라고 했단다.","n":"단희","c":"CH0020"},{"k":"line","t":"그딴 게 해결책...?","n":"나"},{"k":"line","t":"아앙♡! 벗아, 그런 눈으로 바라보면... 하아...♡ 이상한 기분이...♡","n":"단희","c":"CH0020"},{"k":"line","t":"아무튼... 술이 이 몸에 있으니, 부정한 힘도 이 몸 안에 넣으면 될 것 아니냐?","n":"단희","c":"CH0020"},{"k":"line","t":"이 부적은 그 결과인 셈이지.","n":"단희","c":"CH0020"},{"k":"line","t":"즉... 지금 네 몸에는 술과 부정한 힘이 같이 들어있다?","n":"나"},{"k":"line","t":"정답~! 후후, 상이라도 줘야 할까?","n":"단희","c":"CH0020"},{"k":"line","t":"아니, 뭔가 엮이면 안 될 것 같으니 이만 돌아가 봐야겠는데.","n":"나"},{"k":"line","t":"에이~ 그러지 말고.","n":"단희","c":"CH0020"},{"k":"line","t":"여기까지 왔으니 풍류에 어울려 줘야 할 것 아니냐? 그렇지 않고서야 애써 감시에서 벗어난 보람이 없지 않느냐.","n":"단희","c":"CH0020"},{"k":"line","t":"...?","n":"나"},{"k":"line","t":"감시가 뭐?","n":"나"},{"k":"line","t":"감시 말이다. 제암단 녀석들, 얌전히 있으라고 그렇게 호들갑을...","n":"단희","c":"CH0020"},{"k":"line","t":"나 참, 부정한 힘쯤은 쉽게 녹여낼 수 있어서 괜찮대도~","n":"단희","c":"CH0020"},{"k":"line","t":"아니아니, 전문가의 처방에는 얌전히 따라야지.","n":"나"},{"k":"line","t":"지금 걔들이 하는 말을 무시하고 몰래 도망쳐 나왔다는 거야!?","n":"나"},{"k":"line","t":"에이~ 괜찮단다. 내 경험에 따르면 이 정도쯤은~","n":"단희","c":"CH0020"},{"k":"line","t":"...찾았다.","n":"카게","c":"CH0025"},{"k":"line","t":"닌자가 왔다-!","n":"나"},{"k":"line","t":"닌자가 아닙니다. 쿠노이치입니다.","n":"카게","c":"CH0025"},{"k":"line","t":"그거나 그거나...","n":"나"},{"k":"line","t":"이런, 벌써 쫓아온 게냐? 역시 제암단의 일류 쿠노이치 답구나.","n":"단희","c":"CH0020"},{"k":"line","t":"그렇게 칭찬하셔도 안 봐드립니다. 제암단의 눈은 그 누구도 피할 수 없으니까요.","n":"카게","c":"CH0025"},{"k":"line","t":"참고로 단희님이 저희의 감시를 벗어나는 것까지 제 계획에 있었습니다.","n":"카게","c":"CH0025"},{"k":"line","t":"그래? 그렇다면... 내가 어떻게 대응할 지도 계획을 세웠겠구나!","n":"단희","c":"CH0020"},{"k":"line","t":"물론입니다. 그러니까... 단희님의 성격에 따르면 이 상황에서 하실 만한 행동 패턴이 12개... 그 중에서 제가 대응할 방향이 5개... 거기서 또... 중얼중얼...","n":"카게","c":"CH0025"},{"k":"line","t":"...지금이다, 벗아!","n":"단희","c":"CH0020"},{"k":"line","t":"핫!? 여기서 또 도망을...?","n":"카게","c":"CH0025"},{"k":"line","t":"...하지만 그것도 제 계획 내입니다!!","n":"카게","c":"CH0025"}]}]},"6906":{"chat":[{"k":"msg","t":"잡힘","n":"단희","c":"CH0020"},{"k":"reply","o":["ㅋㅋㅋㅋ 그럴 줄 알았다"]},{"k":"msg","t":"아 피했는데","n":"단희","c":"CH0020"},{"k":"reply","o":["가슴 때문에 선회가 느린가"]},{"k":"msg","t":"아니","n":"단희","c":"CH0020"},{"k":"msg","t":"달리다가 부적이 떨어졌어","n":"단희","c":"CH0020"},{"k":"msg","t":"이거 원래 이렇게 떨어지면 안 되는 건데","n":"단희","c":"CH0020"},{"k":"reply","o":["그걸 봤어야 하는데"]},{"k":"msg","t":"변함없이 엉큼한 녀석","n":"단희","c":"CH0020"},{"k":"msg","t":"어쨌든 혼나기는 했는데","n":"단희","c":"CH0020"},{"k":"msg","t":"축제 준비를 돕는다면 봐준다고 하는구나","n":"단희","c":"CH0020"},{"k":"reply","o":["선처받았네 힘내"]},{"k":"msg","t":"안 도와주는 게냐!?","n":"단희","c":"CH0020"},{"k":"msg","t":"술친구 우정은!?","n":"단희","c":"CH0020"},{"k":"reply","o":["세상에 도움 안 되는 게 술친구란다"]},{"k":"msg","t":"하지만 나에겐 술이 있지","n":"단희","c":"CH0020"},{"k":"msg","t":"그것도 최고급으로","n":"단희","c":"CH0020"},{"k":"reply","o":["인질이 좀 쎄군..."]},{"k":"story"},{"k":"msg","t":"벗아","n":"단희","c":"CH0020"},{"k":"reply","o":["톡은 보낼 수 있네 자판 안 부서져?"]},{"k":"msg","t":"괜찮다","n":"단희","c":"CH0020"},{"k":"msg","t":"아까도 잘만 보내지 않았더냐","n":"단희","c":"CH0020"},{"k":"reply","o":["..."]},{"k":"msg","t":"사실 천랑의 힘을 빌렸다","n":"단희","c":"CH0020"},{"k":"reply","o":["대천랑이네"]},{"k":"reply","o":["아니 잠깐 봉인됐다며"]},{"k":"msg","t":"잠깐 힘을 빌리는 정도라면 할 수 있단다","n":"단희","c":"CH0020"},{"k":"msg","t":"사실 봉인도 마음만 먹으면 풀 수 있지만...","n":"단희","c":"CH0020"},{"k":"reply","o":["...근데 천랑의 힘은 어떻게 빌린 거지"]},{"k":"msg","t":"가슴 사이로 머리만 소환해서 부리로(천랑)","n":"단희","c":"CH0020"},{"k":"reply","o":["대 천 랑"]},{"k":"msg","t":"더 칭찬해라 나를(천랑)","n":"단희","c":"CH0020"},{"k":"msg","t":"아니 천랑아 내 톡이다만","n":"단희","c":"CH0020"},{"k":"msg","t":"아무튼 벗아 다음에야말로 축제를 성공시켜 함께 잔을 들자꾸나","n":"단희","c":"CH0020"},{"k":"reply","o":["좋아 기대할게"]}],"story":[{"k":"text","lines":[{"k":"narration","t":"할로윈 축제 준비로 분주한 천등가에 도착했다."},{"k":"place","t":"천등가"},{"k":"line","t":"오, 벗아!","n":"단희","c":"CH0020"},{"k":"narration","t":"그리고 전라가 있었다."},{"k":"line","t":"나야 좋지만 이대로 괜찮은가, 사군자...","n":"나"},{"k":"line","t":"응? 무슨 말이냐?","n":"단희","c":"CH0020"},{"k":"line","t":"사군자의 풍기에 대해 걱정하고 있었어.","n":"나"},{"k":"line","t":"하핫, 걱정할 게 있느냐? 하나같이 점잔 빼는 녀석들뿐인데.","n":"단희","c":"CH0020"},{"k":"line","t":"나로서는 좀 더 개방적이 되어도 좋다고 생각하다만.","n":"단희","c":"CH0020"},{"k":"line","t":"개방적...?","n":"나"},{"k":"line","t":"여기서 얼마나 더 개방적이 되려고?","n":"나"},{"k":"line","t":"으응~? 왜, 여기서 더 개방적이 된 모습을 보고 싶은 게냐?","n":"단희","c":"CH0020"},{"k":"line","t":"당연하지!","n":"나"},{"k":"line","t":"나 참. 어쩔 수 없는 녀석이구나♡","n":"단희","c":"CH0020"},{"k":"line","t":"잠깐, 멈춰! 나야 좋지만 여기서 잡혀가고 싶진 않거든?!","n":"나"},{"k":"line","t":"안 그래도 후마니타스에서 의도치 않게 공연음란죄로 체포됐었는데...","n":"나"},{"k":"line","t":"호오? 그래서 뭐 나쁠 게 있느냐.","n":"단희","c":"CH0020"},{"k":"line","t":"그때랑 똑같은 꼴은 사양이야. 여기는 파노티콘 같은 고급 시설이 있는 것 같지도 않고...","n":"나"},{"k":"line","t":"흐음... 어쩔 수 없구나. 난 벗과 함께 체포되는 것도 나쁘지 않다만.","n":"단희","c":"CH0020"},{"k":"line","t":"그런 범죄 스릴러에나 나올 법한 이야긴 됐고, 내가 여기 오게 한 목적이나 빨리 말해.","n":"나"},{"k":"line","t":"응? 목적이라고?","n":"단희","c":"CH0020"},{"k":"line","t":"이제 와서 모르는 척할 거야? 인질을 잡았잖아.","n":"나"},{"k":"line","t":"...","n":"단희","c":"CH0020"},{"k":"line","t":"아~~!! 그, 그렇지. 인질을 잡았지!","n":"단희","c":"CH0020"},{"k":"line","t":"뭔가 수상한데... 인질은 무사하겠지?","n":"나"},{"k":"line","t":"후훗, 물론이고말고. 맛과 향이 살아있는 그대로란다. 사소한 문제가 있긴 하지만...","n":"단희","c":"CH0020"},{"k":"line","t":"사소한... 문제? 설마 전부 마셔버렸다던가?","n":"나"},{"k":"line","t":"...정말, 벗과 내가 충분히 마실 만큼은 남겼으니 걱정 말거라.","n":"단희","c":"CH0020"},{"k":"line","t":"다만 잔을 나누기 전에 몇 가지 해결해야 할 일이 있단 말이지.","n":"단희","c":"CH0020"},{"k":"line","t":"애초에 일도 없이 부를 거라 생각하진 않았지.","n":"나"},{"k":"line","t":"정말~ 벗아. 넌 나를 뭐라고 생각하는 게냐?","n":"단희","c":"CH0020"},{"k":"line","t":"...문제 생성기?","n":"나"},{"k":"line","t":"아니, 물론 내가 사고를 많이 치는 편이긴 하다만...","n":"단희","c":"CH0020"},{"k":"line","t":"으, 으흠! 정말, 그렇게 말해서야 내 체면이 없지 않느냐. 조금은 돌려서...","n":"단희","c":"CH0020"},{"k":"line","t":"이것도 돌려서 말한 거니까 빨리 해야 할 일이나 말해.","n":"나"},{"k":"line","t":"자꾸 뜸 들이면 그 몸에 붙은 부적도 돌려 버릴 거야.","n":"나"},{"k":"line","t":"이 무도한 녀석. 사군자를 통틀어서도 나를 이렇게 대할 수 있는 건 너뿐일 게다.","n":"단희","c":"CH0020"},{"k":"line","t":"아무튼, 무슨 일인고 하니...","n":"단희","c":"CH0020"},{"k":"line","t":"아무튼 단희님의 그러한 행동도 제 계획에 있었습니다.","n":"카게","c":"CH0025"},{"k":"line","t":"쟤는 뭐만 하면 계획대로래.","n":"나"},{"k":"line","t":"후후, 그런 모습이 귀엽지 않느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"뭐, 부정하진 않겠어.","n":"나"},{"k":"line","t":"그래서 어차피 감시에서 벗어날 단희님을 붙잡아두기보다는, 저희의 시선 아래에 모셔두는 게 좋다고 판단했고...","n":"카게","c":"CH0025"},{"k":"line","t":"...단희님이 마시다 남긴 위령주를 제가 은밀한 곳에 숨겨두었습니다.","n":"카게","c":"CH0025"},{"k":"line","t":"!? 내 술!","n":"나"},{"k":"line","t":"아니, 벗아. 우리의 술이지?","n":"단희","c":"CH0020"},{"k":"line","t":"그것보다 인질을 인질로 잡혔어? 지금 그래 놓고 나를 부른 거야, 이거?","n":"나"},{"k":"line","t":"술을 돌려받고 싶으시면... 축제 준비를 도와주셔야겠습니다.","n":"카게","c":"CH0025"},{"k":"line","t":"본래 위령주로 정화하려던 부정한 힘을, 위령주를 마신 단희님이 돌아다니는 것으로 해결하는 것이죠.","n":"카게","c":"CH0025"},{"k":"line","t":"게다가 가문에서 단희님께 내린 징계도 겸할 수 있으니 이거야말로 일석삼조... 완벽한 계획입니다.","n":"카게","c":"CH0025"},{"k":"line","t":"...그러니, 지금부터 인질을 되찾으러 간다!","n":"단희","c":"CH0020"},{"k":"line","t":"사기 신고는 어디로 하면 되지? 아니면 월영단? 아니면 사계 직통?","n":"나"},{"k":"line","t":"그, 그렇게 하면 문제가 커지니 참아주거라!?","n":"단희","c":"CH0020"},{"k":"line","t":"흠, 흠! 미안하게 되었구나, 벗아. 하지만 약속은 유효하고, 신의는 분명하니...","n":"단희","c":"CH0020"},{"k":"line","t":"나를 도와 축제 준비를 도와라! 그러면 우리 함께 맛있는 술을 나눌 수 있지 않겠느냐?!","n":"단희","c":"CH0020"},{"k":"line","t":"와... 어쩜 이리 낯짝 하나 안 변하고...","n":"나"},{"k":"line","t":"이거 술 한잔으로 낚이기에는 너무 비싼데...","n":"나"},{"k":"narration","t":"그렇게 단희와 함께 축제 준비를 돕게 되었는데..."},{"k":"line","t":"여기~! 손 비는 사람 있으면 도와줘~! 매대를 세워야 돼!","n":"가게 상인 1","c":"SC0213"},{"k":"line","t":"호오, 도움이 필요한가? 잠깐 기다리거라!","n":"단희","c":"CH0020"},{"k":"line","t":"앗! 당신은... 단희님!? 잠깐-","n":"가게 상인 1","c":"SC0213"},{"k":"line","t":"이런! 부서져 버렸구나. 겨우 이 정도로 부러지다니 나약한 기둥이로고.","n":"단희","c":"CH0020"},{"k":"line","t":"내, 내 가게가...!","n":"가게 상인 1","c":"SC0213"},{"k":"line","t":"잠깐, 진정해. 아직 기둥 하나가 당했을 뿐이다.","n":"나"},{"k":"line","t":"우리에겐 아직 세 개의 기둥이...","n":"나"},{"k":"line","t":"이런! 요즘 기둥들은 다 이렇게 약하게 나오나?","n":"단희","c":"CH0020"},{"k":"line","t":"장사는 시작도 못 했는데 망해버렸어...!","n":"가게 상인 1","c":"SC0213"},{"k":"line","t":"...괜찮아, 변상은 제암단에서 할 계획이니까.","n":"나"},{"k":"line","t":"앗, 그러면 괜찮을지도? 판매하려던 물건들까지 같이 묶어서 요청해도 되겠지?","n":"가게 상인 1","c":"SC0213"},{"k":"line","t":"으음... 곤란하구나. 천랑이라도 있었다면 맡겼을 텐데.","n":"단희","c":"CH0020"},{"k":"line","t":"그러고 보니 천랑은 어디 간 거야?","n":"나"},{"k":"line","t":"가문의 녀석들이 같이 봉인해 버렸단다. '가끔은 스스로 일 좀 하세요'라니...","n":"단희","c":"CH0020"},{"k":"line","t":"뭐, 천랑 녀석으로선 간만의 휴식인 셈이지. 평소에는 내 잔심부름으로 바빴으니까.","n":"단희","c":"CH0020"},{"k":"line","t":"...지금까지 대체 어떤 싸움을 해 오신 겁니까 천랑 선생...","n":"나"},{"k":"line","t":"아무튼 여긴 끝난 듯하니 이동하자고.","n":"나"},{"k":"line","t":"으아~! 조금 있으면 개장인데 아직도 재료 손질도 안 끝났어! 누군가 도와줘!","n":"가게 상인 2","c":"SC0214"},{"k":"line","t":"흠. 내 도움이 필요한가 보구나! 그렇다면 가만있을 수 없지!","n":"단희","c":"CH0020"},{"k":"line","t":"앗! 단희님!? 잠깐만요~!","n":"가게 상인 2","c":"SC0214"},{"k":"line","t":"...나 이거 어디서 본 거 같은데.","n":"나"},{"k":"line","t":"좋아, 문제의 근원인 축제를 파괴한다. 작전은 순조로워.","n":"나"},{"k":"line","t":"그런 작전이 있었느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"겠냐? 아니, 무슨 파괴의 손도 아니고 가는 곳마다 다 부수고 다녀?","n":"나"},{"k":"line","t":"전에는 허접이긴 했어도 이 정도는 아니었는데... 혹시 그 봉인 때문이야?","n":"나"},{"k":"line","t":"음. 부정한 힘을 몸에 담아서 정화하는 술식인데... 오히려 그 때문에 좀처럼 힘을 억제할 수가 없구나.","n":"단희","c":"CH0020"},{"k":"line","t":"그거 안전한 거야? 옮는 건 아니지?","n":"나"},{"k":"line","t":"이게 무슨 감기인 줄 아느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"걱정하진 않아도 좋다. 부정한 힘이 이 몸을 침범하는 건 불가능하니까.","n":"단희","c":"CH0020"},{"k":"line","t":"그렇긴 해도... 곤란하구나. 이래서야 축제를 즐기지도, 도움을 주지도 못하다니.","n":"단희","c":"CH0020"},{"k":"line","t":"뭐야, 쫀 거야? 너답지 않네.","n":"나"},{"k":"line","t":"?!","n":"단희","c":"CH0020"},{"k":"line","t":"봉인이니, 부정한 힘이니 그런 사소한 건 알 바 아니고.","n":"나"},{"k":"line","t":"고작 그런 패널티에- 겨우 두 번 실패했다고 배 까고 항복선언이라니.","n":"나"},{"k":"line","t":"불리한 게임에서 처발려도 계속 덤비던 그 근성은 어디갔어?","n":"나"},{"k":"line","t":"...배, 배 까고 항복 선언...","n":"단희","c":"CH0020"},{"k":"line","t":"후, 후후... 하하핫...!","n":"단희","c":"CH0020"},{"k":"line","t":"그렇게 보였단 말이냐?","n":"단희","c":"CH0020"},{"k":"line","t":"역시 내 벗이야. 도발 버튼 하나는 기가 막히게 누르는구나.","n":"단희","c":"CH0020"},{"k":"line","t":"네가 원체 허접이어야 말이지.","n":"나"},{"k":"line","t":"네 말 대로다. 겨우 두 번 실수한 것 가지고 쫄아서야 안 되지.","n":"단희","c":"CH0020"},{"k":"line","t":"그렇다면... 벗아. 한 번 더 나와 어울려 주겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"당연하지. 난 아직 그 술 한 모금도 못 마셨다고.","n":"나"}]}]},"6912":{"chat":[{"k":"msg","t":"부숴버렸어","n":"단희","c":"CH0020"},{"k":"reply","o":["그렇지"]},{"k":"msg","t":"?","n":"단희","c":"CH0020"},{"k":"reply","o":["아 미안 그렇겠지 라고 하는 게"]},{"k":"msg","t":"똑같은 말이잖아","n":"단희","c":"CH0020"},{"k":"reply","o":["아무튼, 뭘 부쉈다는 건데"]},{"k":"reply","o":["가게? 미래? 희망?"]},{"k":"msg","t":"뒤에 두 개는 뭔데","n":"단희","c":"CH0020"},{"k":"msg","t":"아니 그 후에 유령의 집을 돕다가","n":"단희","c":"CH0020"},{"k":"msg","t":"장치들을 부숴버려서","n":"단희","c":"CH0020"},{"k":"reply","o":["넌 그냥 그 손을 봉인해라"]},{"k":"msg","t":"그치만","n":"단희","c":"CH0020"},{"k":"msg","t":"빨리 술을 찾아야 벗과 마실 수 있다 생각하니 참을 수 없었는걸","n":"단희","c":"CH0020"},{"k":"reply","o":["에이 맘 약해지게 금방 갈 테니 꼼짝 말고 있어"]},{"k":"story"},{"k":"msg","t":"벗아","n":"단희","c":"CH0020"},{"k":"msg","t":"괜찮냐?","n":"단희","c":"CH0020"},{"k":"reply","o":["하마터면 가슴사 할 뻔했어"]},{"k":"msg","t":"가슴사?!","n":"단희","c":"CH0020"},{"k":"msg","t":"그럴 의도는 아니었는데 미안하게 됐다","n":"단희","c":"CH0020"},{"k":"reply","o":["됐어 기분은 좋았고 어쨌든 살았고"]},{"k":"reply","o":["감각은 좀 어때?"]},{"k":"msg","t":"아까보다는 무뎌진 편이다","n":"단희","c":"CH0020"},{"k":"msg","t":"부정한 힘이 다시 커지면서 감각이 둔해진 모양이야","n":"단희","c":"CH0020"},{"k":"msg","t":"그래서 말인데 벗아","n":"단희","c":"CH0020"},{"k":"msg","t":"...","n":"단희","c":"CH0020"},{"k":"msg","t":"또 해주지 않겠느냐?","n":"단희","c":"CH0020"},{"k":"reply","o":["거절 할 이유는 없지"]}],"story":[{"k":"text","lines":[{"k":"narration","t":"단희가 보내준 대로 유령의 집에 들어왔다."},{"k":"place","t":"유령의 집"},{"k":"line","t":"벗아, 도와다오!","n":"단희","c":"CH0020"},{"k":"narration","t":"그리고 가슴이 있었다."},{"k":"line","t":"어쩔 수 없지...","n":"나"},{"k":"line","t":"!?\n벗아, 지금 뭘...","n":"단희","c":"CH0020"},{"k":"line","t":"무거우니까 들어달라는 거 아니야?","n":"나"},{"k":"line","t":"그럴 리가 있겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"아, 그런데 조금 편할지도...","n":"단희","c":"CH0020"},{"k":"line","t":"난 괜찮아.","n":"나"},{"k":"line","t":"아앙♡\n내, 내가 안 괜찮단 말이다.","n":"단희","c":"CH0020"},{"k":"line","t":"아니 그보다 벗아, 지금 중요한 건 그게 아니란다.","n":"단희","c":"CH0020"},{"k":"line","t":"큰일이야, 큰일~!\n왜 장식들이 부서져 있는 거지!?","n":"스태프1","c":"NP0103"},{"k":"line","t":"우와앗~!?\n손님을 놀래켜 주는 장치들이... 죄다 망가졌잖아?! 기술팀!","n":"키티 불리","c":"NP0502"},{"k":"line","t":"...","n":"단희","c":"CH0020"},{"k":"line","t":"또 저지르셨군요.","n":"나"},{"k":"line","t":"아앙♡! 벗아, 그런 눈으로 바라보면... 그치만, 내 딴에는 잘 해보겠다고 했는데...","n":"단희","c":"CH0020"},{"k":"line","t":"하면 할수록 부숴버리기만 하니... 진퇴양난!\n앞으로도 뒤로도 갈 수 없는 상황이로구나.","n":"단희","c":"CH0020"},{"k":"line","t":"이대로는 도움도 못 되고 술도 찾지 못할 터이니...\n약속도 지키지 못할 거 아니냐?","n":"단희","c":"CH0020"},{"k":"line","t":"한 가지, 방법이 있어.","n":"나"},{"k":"line","t":"뭐?\n그게 정말이냐?","n":"단희","c":"CH0020"},{"k":"line","t":"진짜야. 단지 여기에는 대가가 따르는데...","n":"나"},{"k":"line","t":"벗아, 내가 대가를 두려워할 사람으로 보이느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"간 보지 말고 빨랑빨랑 말하거라, 기다리느라 애가 타지 않느냐.","n":"단희","c":"CH0020"},{"k":"line","t":"좋아, 그러면...\n방법이 있지.","n":"나"},{"k":"line","t":"?!","n":"단희","c":"CH0020"},{"k":"line","t":"네가 힘을 제어하지 못하는 건 봉인 때문이잖아?","n":"나"},{"k":"line","t":"그래서...\n어제 카게를 만나서 부적 설명서를 받았단 말이지.","n":"나"},{"k":"line","t":"환락상단의 뭐시기 저시기라고 써있었는데...","n":"나"},{"k":"line","t":"부적 설명서라고?\n뭐시기 저시기?","n":"단희","c":"CH0020"},{"k":"line","t":"아 그런 사소한 건 됐고, 네 몸에 붙어있는 그것 말이야...","n":"나"},{"k":"line","t":"듣자 하니 네 몸에 붙은 그 부적, 출력 조정이 가능하다고 하더라고.","n":"나"},{"k":"line","t":"부적의 힘을 조율하면, 네 힘도 폭주하지 않을 거고 물건을 부숴버리는 일도 없어지지 않겠어?","n":"나"},{"k":"line","t":"오오-! 그런 방법이!","n":"단희","c":"CH0020"},{"k":"line","t":"다만...\n부작용이 조금 있는데...","n":"나"},{"k":"line","t":"부작용?\n...아니, 내가 부작용 따위에 당할 리 없지 않느냐.","n":"단희","c":"CH0020"},{"k":"line","t":"아니, 조금 특수한 부작용이라서...\n온몸의 감각이 몇 배나 향상된다고 하더라고.","n":"나"},{"k":"line","t":"온몸의 감각이...!?","n":"단희","c":"CH0020"},{"k":"line","t":"그래, 대략... 30배 정도려나?","n":"나"},{"k":"line","t":"30배...!","n":"단희","c":"CH0020"},{"k":"line","t":"그래서 잘못하면 말 그대로 정신이 맛 가버리거나, 여러 의미로 가버릴 수도 있지.","n":"나"},{"k":"line","t":"아니, 잘못 하면 바람만 불거나 옷깃만 스치기만 해도...","n":"나"},{"k":"line","t":"...!?","n":"단희","c":"CH0020"},{"k":"line","t":"그래서 할까, 말까? 정 무서우면 안 해도...","n":"나"},{"k":"line","t":"후, 후, 후... 우문이구나, 벗아.","n":"단희","c":"CH0020"},{"k":"line","t":"내가, 이 몸이, 여기까지 와서... 도망가리라 생각하는 거냐!?","n":"단희","c":"CH0020"},{"k":"line","t":"뭐, 너라면 그럴 거라고 생각했어.","n":"나"},{"k":"line","t":"그럼 각오는 된 거지?","n":"나"},{"k":"line","t":"애초에 각오고 자시고 할 것도 없단다. 난 언제나 준비가 되어 있으니까 말이지!","n":"단희","c":"CH0020"},{"k":"line","t":"자, 그럼 어디 마음대로 해보거라!!","n":"단희","c":"CH0020"},{"k":"line","t":"좋아, 그럼 여기선 조금 그러니 장소를 옮겨 보자고.","n":"나"}]},{"k":"scene","kind":"desire"},{"k":"text","lines":[{"k":"line","t":"하... 하읏♡...","n":"단희","c":"CH0020"},{"k":"line","t":"정신이 좀 들어?","n":"나"},{"k":"line","t":"자, 잠깐. 벗아. 말 걸지 말아다오... 네 소리가 들리면, 귓속이...","n":"단희","c":"CH0020"},{"k":"line","t":"후우~","n":"나"},{"k":"line","t":"하으아앙♡!?","n":"단희","c":"CH0020"},{"k":"line","t":"오, 생각했던 것보다... 자극이 강한가 보지?","n":"나"},{"k":"line","t":"그, 그러니까...! 감도가... 너무... 쎄서...","n":"단희","c":"CH0020"},{"k":"line","t":"얍.","n":"나"},{"k":"line","t":"히양~~~~♡♡♡!?","n":"단희","c":"CH0020"},{"k":"line","t":"우응...! 아, 아앗...!","n":"단희","c":"CH0020"},{"k":"line","t":"이런, 여기서 가버리면 어쩌자는 거야?","n":"나"},{"k":"line","t":"그건 네, 네가...!","n":"단희","c":"CH0020"},{"k":"line","t":"버, 벗아. 이래서야 제대로 일도 못 하지 않느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"아니. 이제야 제대로 일할 수 있겠네, 자.","n":"나"},{"k":"line","t":"?!","n":"단희","c":"CH0020"},{"k":"line","t":"한번 왼쪽에 있는 소품을 옮겨봐.","n":"나"},{"k":"line","t":"...이것 말이냐?","n":"단희","c":"CH0020"},{"k":"line","t":"아흣...♡","n":"단희","c":"CH0020"},{"k":"line","t":"했다만...?","n":"단희","c":"CH0020"},{"k":"line","t":"봐, 제대로 옮겼잖아.","n":"나"},{"k":"line","t":"...","n":"단희","c":"CH0020"},{"k":"line","t":"앗...!!","n":"단희","c":"CH0020"},{"k":"line","t":"그러고보니... 전이었으면 상자째 부숴버렸을 것을...","n":"단희","c":"CH0020"},{"k":"line","t":"감각이 예민해진 덕분에 힘을 조절할 수 있게 된 거지.","n":"나"},{"k":"line","t":"이제 네가 부쉈던 것들을 고치기만 하면...","n":"나"},{"k":"line","t":"대단하구나, 벗아!","n":"단희","c":"CH0020"},{"k":"line","t":"우왓?!","n":"나"},{"k":"line","t":"하, 하으으응~~~♡!?","n":"단희","c":"CH0020"},{"k":"line","t":"야, 야?! 껴안은 채로 가버리지 마!","n":"나"}]}]},"6916":{"chat":[{"k":"msg","t":"벗아 큰일이다","n":"단희","c":"CH0020"},{"k":"reply","o":["뭔데"]},{"k":"msg","t":"장사가 안돼","n":"단희","c":"CH0020"},{"k":"msg","t":"이대로라면 술을 돌려받겠다는 계획이","n":"단희","c":"CH0020"},{"k":"reply","o":["또 그거냐 슬슬 질리는데"]},{"k":"msg","t":"숨을 들이쉬면 콧속을 파고드는 꽃과 같은 향기에","n":"단희","c":"CH0020"},{"k":"msg","t":"입에 머금으면 설탕같이 달콤하며 소금같이 짭쪼름하고","n":"단희","c":"CH0020"},{"k":"msg","t":"목으로 넘기면 연한 두부처럼 꼴딱 넘어가니","n":"단희","c":"CH0020"},{"k":"reply","o":["뭐야 이 자식 청산유수"]},{"k":"reply","o":["설마 나 빼고 한잔했냐"]},{"k":"msg","t":"설마 내가 벗을 빼고 혼자 먹었을까","n":"단희","c":"CH0020"},{"k":"msg","t":"무엇보다도 벗과 함께 맛있는 술을 먹고 싶은데~","n":"단희","c":"CH0020"},{"k":"reply","o":["너어는 진짜"]},{"k":"msg","t":"그럼 오는 줄 알고 유령의 집에서 기다리마♡","n":"단희","c":"CH0020"},{"k":"story"},{"k":"msg","t":"대박이야","n":"단희","c":"CH0020"},{"k":"msg","t":"네 덕분이다 벗아","n":"단희","c":"CH0020"},{"k":"reply","o":["항상 감사하도록"]},{"k":"msg","t":"사양하지 않는 게 네 좋은 점이지","n":"단희","c":"CH0020"},{"k":"reply","o":["그래서 인질은 돌려받았어?"]},{"k":"msg","t":"그래","n":"단희","c":"CH0020"},{"k":"msg","t":"카게한테 방금 받았단다","n":"단희","c":"CH0020"},{"k":"reply","o":["먼저 마시지 마"]},{"k":"msg","t":"나를 못 믿는 거냐 벗아","n":"단희","c":"CH0020"},{"k":"reply","o":["이미 그거 대부분 마신 널 잘도 믿겠다"]},{"k":"msg","t":"넌 나에 대해 너무 잘 알고 있구나","n":"단희","c":"CH0020"},{"k":"msg","t":"알았다 벗아","n":"단희","c":"CH0020"},{"k":"msg","t":"조만간 연락하마","n":"단희","c":"CH0020"}],"story":[{"k":"text","lines":[{"k":"place","t":"유령의 집"},{"k":"line","t":"자, 어디 한 번 해봐.","n":"나"},{"k":"line","t":"과자를 내놓지 않으면~ 잡아먹겠다~!","n":"단희","c":"CH0020"},{"k":"line","t":"틀렸어. 겨우 그 정도로 손님을 놀래키겠다고?","n":"나"},{"k":"line","t":"?!","n":"단희","c":"CH0020"},{"k":"line","t":"지금의 너는 전혀 위협적이지 않아.","n":"나"},{"k":"line","t":"그, 그런가?","n":"단희","c":"CH0020"},{"k":"line","t":"자, 다시 해 봐.","n":"나"},{"k":"line","t":"과자를 내놓지 않으면...!","n":"단희","c":"CH0020"},{"k":"line","t":"틀렸어!","n":"나"},{"k":"line","t":"흐앙♡!?","n":"단희","c":"CH0020"},{"k":"line","t":"그래, 이런 느낌이지.","n":"나"},{"k":"line","t":"아니, 벗아. 이건 놀래키는 게 아니잖아?","n":"단희","c":"CH0020"},{"k":"line","t":"애초에 놀래킨다는 게 뭔데? 갑자기 튀어나오면 다 놀라나?","n":"나"},{"k":"line","t":"그건... 아니지?","n":"단희","c":"CH0020"},{"k":"line","t":"내가 아는 놀래킨다는 건... 의표를 찌르는 거야.","n":"나"},{"k":"line","t":"상대가 생각지도 못한 타이밍에, 생각지도 못한 걸 보여주는 거지.","n":"나"},{"k":"line","t":"이런 식으로.","n":"나"},{"k":"line","t":"하으응~♡?!","n":"단희","c":"CH0020"},{"k":"line","t":"좀 감이 잡혀?","n":"나"},{"k":"line","t":"이런, 정말... 터무니없는 녀석이구나.","n":"단희","c":"CH0020"},{"k":"line","t":"하지만 틀린 말은 아닐지도...","n":"단희","c":"CH0020"},{"k":"line","t":"마침 손님이 오네, 한 번 해봐.","n":"나"},{"k":"line","t":"좋아! 자, 과자를 내놓지 않으면...","n":"단희","c":"CH0020"},{"k":"line","t":"으햐앙~~♡♡♡!?","n":"단희","c":"CH0020"},{"k":"line","t":"꺄아악~~~!?","n":"손님1","c":"NP0203"},{"k":"line","t":"가, 가슴 귀신이다~?!?!","n":"손님2","c":"NP0212"},{"k":"line","t":"가, 가슴 귀신...","n":"단희","c":"CH0020"},{"k":"line","t":"좋아, 그거야.","n":"나"},{"k":"line","t":"아니지?! 벗아, 이건 놀라서 달아난 게 아니라 그냥 가슴을 보고 달아난 것 아니냐?","n":"단희","c":"CH0020"},{"k":"line","t":"문제라도?","n":"나"},{"k":"line","t":"문제가 많지! 여긴 유령의 집이란 말이다. 가슴의 집은 아니란 말이다!","n":"단희","c":"CH0020"},{"k":"line","t":"가슴의 집이든 유령의 집이든 놀라면 된 거 아니야?","n":"나"},{"k":"line","t":"그리고 지금 네가 눈 돌릴 시간이 있어? 또 다음 손님이 온다?","n":"나"},{"k":"line","t":"후, 후후. 베르몬트에서 여기까지 놀러 와서 유령의 집이라니...","n":"손님3","c":"NP0411"},{"k":"line","t":"하지만 이것도 시련...! 믿음으로 공포를 눌러야만...!","n":"손님3","c":"NP0411"},{"k":"line","t":"맞아요, 하모닉스님의 은총을 받는 저희에게 유령쯤은...","n":"손님4","c":"NP0402"},{"k":"line","t":"후우, 이번에야말로...","n":"단희","c":"CH0020"},{"k":"line","t":"자, 과자가 아니면 장난을...!","n":"단희","c":"CH0020"},{"k":"line","t":"하아아앙~~~♡♡!!","n":"단희","c":"CH0020"},{"k":"line","t":"히야아아앙!?!?","n":"손님3","c":"NP0411"},{"k":"line","t":"하, 하모닉스니이임~~~!?","n":"손님4","c":"NP0402"},{"k":"line","t":"완벽해.","n":"나"},{"k":"line","t":"...뭐가 완벽이냐! 정말, 남의 엉덩이를 스위치처럼 쓰다니.","n":"단희","c":"CH0020"},{"k":"line","t":"그렇게라도 써 주는 걸 고맙게 생각해. 더 심하게 써줄 방법도 많으니까.","n":"나"},{"k":"line","t":"뭐무므뭐뭣?!","n":"단희","c":"CH0020"},{"k":"line","t":"아무튼, 리액션은 괜찮아진 것 같은데...","n":"나"},{"k":"line","t":"으음... 확실히 손님들 반응이 더 좋아진 것 같기도...","n":"단희","c":"CH0020"},{"k":"line","t":"뭐, 좀 더 자극적으로 가면 '천장에서 전라가' 라던가 '어둠으로부터 압도적 가슴' 같은 것도 있긴 한데...","n":"나"},{"k":"line","t":"그렇게 했다간 진짜 가슴의 집이 될 것 같으니 그만두자꾸나.","n":"단희","c":"CH0020"},{"k":"line","t":"쓰읍... 아쉽네.","n":"나"},{"k":"line","t":"그래도 이제야 겨우 손님이 좀 늘기 시작했는데.","n":"나"},{"k":"line","t":"확실히, 벗의 솜씨는 놀랄 만하구나.","n":"단희","c":"CH0020"},{"k":"line","t":"설마하니 이런 '에로호러 하우스'같은 방식으로 사람을 모으다니...","n":"단희","c":"CH0020"},{"k":"line","t":"원래 에로와 호러는 한 몸이라고. ...어라?","n":"나"},{"k":"line","t":"으음, 입구 쪽이 시끄럽구나.","n":"단희","c":"CH0020"},{"k":"line","t":"고, 곤란합니다, 손님! 그쪽은 아직 준비가...","n":"스태프1","c":"SC0204"},{"k":"line","t":"흐~~~응? 우린 이미 돈을 지불했는데. 준비가 안 된 건 그쪽 잘못 아닌가요?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"맞아, 맞아! 우린 손님이라고. 곤란한 건 그쪽 사정이고~","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"호호호... 유령의 집이라고 해서 와봤더니, 무섭기는커녕 웃기기만 한데. 이름을 유령의 집에서 만담의 집으로 바꾸는 게 좋겠어요.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"오~호호호호호~~!","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"끄응...!","n":"스태프1","c":"SC0204"},{"k":"line","t":"호오... 저게 말로만 듣던 진상이라는 녀석들인가?","n":"단희","c":"CH0020"},{"k":"line","t":"겨우 가게가 정상화되었는데, 저런 녀석들이 방해하게 둘 순 없지.","n":"단희","c":"CH0020"},{"k":"line","t":"잠깐.","n":"나"},{"k":"line","t":"...? 무엇이냐, 벗아?","n":"단희","c":"CH0020"},{"k":"line","t":"설마하니 저들을 두고 보라는 말은 아니겠지?","n":"단희","c":"CH0020"},{"k":"line","t":"그럴 리가. 저 녀석들, 혼내줄 생각이지?","n":"나"},{"k":"line","t":"그래야 하지 않겠느냐? 또다시 저런 짓 못 하게 따끔하게 혼내줘야지.","n":"단희","c":"CH0020"},{"k":"line","t":"그것도 좋지만...","n":"나"},{"k":"line","t":"더 쓸모 있게 혼내주는 법이 있다면 어떡할래?","n":"나"},{"k":"line","t":"...쓸모있게?","n":"단희","c":"CH0020"},{"k":"line","t":"뭐, 한번 들어보라고.","n":"나"},{"k":"line","t":"호호... 손님들이 몰린다고 해서 와봤더니 별거 아니잖아?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"이래서야 우리가 연 '귀신의 집'에는 상대도 안 되겠네요. 괜히 걱정했어.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"그러게 말임다. 아, 그래도 이 강시 인형은 꽤 잘 만들었을지도...","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"뭐라구~?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"아~~~! 아님다! 이깟 인형은 저희 가게에 있는 인형들에 비하면 아무것도 아니죠!","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"후후... 그렇지~~?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"안 그래도 후마니타스에서 입지가 좁아졌으니... 이렇게 된 이상 다각도로 사업을 넓히지 않으면...","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"그보다 이 강시는 왜 이런 곳에 놔둔 거야? 기분 나쁘게.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"어라? 말랑말랑하네?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"신기하죠? 다른 것들은 그냥 딱딱한 인형 같은데, 이건 장인의 숨결이 느껴진다니까요!","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"꼭 살아 있는 것처럼...","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"흐, 흥! 그래봐야 흉내내기 일 뿐... 어차피 우리 가게의 상대는 안 되겠지만...","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"그래도 혹시 모르니 조금 '장난'을 치도록 할까?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"장난 말임까? 낙서라도 할까요?","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"호호, 그것도 좋겠네. 마침 그릴 곳도 잔뜩 있으니.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"알겠슴다!","n":"진상 손님2","c":"NP0502"},{"k":"line","t":"후후... 보아하니 이쪽도 돈을 제법 들인 것 같지만, 절대로 질 수는 없어요.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"이번 축제에서 반드시 본전을 뽑지 않으면 슬슬 본사에서 압박이...","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"호오... 그래? 그거 큰일이로구나.","n":"단희","c":"CH0020"},{"k":"line","t":"그러니까요. 본사에 잡혀가느니 차라리 귀신이라도 되는 게 나을 지경이라니까요.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"그렇구나. 그러면...","n":"단희","c":"CH0020"},{"k":"line","t":"한번, 귀신이 되어보겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"...?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"우.","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"우냐아아아아앙~~~~~~!?","n":"진상 손님1","c":"NP0509"},{"k":"line","t":"우와~! 이거 진짜 같아~!","n":"손님5","c":"NP0304"},{"k":"line","t":"소문대로네! 마치 살아있는 것 같아...!","n":"손님6","c":"NP0306"},{"k":"line","t":"후후후후후~~~ 자아~~~ 과자를 내놓지 않으면 잡아먹겠다~~~","n":"단희","c":"CH0020"},{"k":"line","t":"꺄아아아앗~~~!?","n":"손님5","c":"NP0304"}]}]},"6920":{"chat":[{"k":"msg","t":"누군가는 달 아래에서 홀로 잔을 기울이나","n":"단희","c":"CH0020"},{"k":"msg","t":"나는 다행히 좋은 벗이 있구나","n":"단희","c":"CH0020"},{"k":"msg","t":"잔을 들어 마주 화답하니","n":"단희","c":"CH0020"},{"k":"msg","t":"바람도 달도 부러워 고개를 숙이는구나","n":"단희","c":"CH0020"},{"k":"reply","o":["뭐야 갑자기"]},{"k":"reply","o":["혼자서 시를 읊기 시작하다니 취한 거냐"]},{"k":"msg","t":"풍류를 읊었을 뿐이란다.","n":"단희","c":"CH0020"},{"k":"msg","t":"가끔은 이런 것도 좋지 않겠느냐?","n":"단희","c":"CH0020"},{"k":"reply","o":["난 시 같은 건 잘 모르는데"]},{"k":"msg","t":"모른다는 걸 아니 이미 알고 있는 거나 다름없구나","n":"단희","c":"CH0020"},{"k":"msg","t":"어차피 이곳에 있는 건 벗과 나뿐이니 한 번 읊어 보거라.","n":"단희","c":"CH0020"},{"k":"reply","o":["달밤에 술 한 잔"]},{"k":"reply","o":["달밤에 술 두 잔"]},{"k":"reply","o":["달밤에 술 세 잔"]},{"k":"msg","t":"그만 마셔","n":"단희","c":"CH0020"},{"k":"reply","o":["아 아 죽이는 달이다-"]},{"k":"msg","t":"...","n":"단희","c":"CH0020"},{"k":"msg","t":"나 빼고 벗이 혼자 마셨느냐","n":"단희","c":"CH0020"},{"k":"story"},{"k":"msg","t":"아 맞다 술","n":"단희","c":"CH0020"},{"k":"reply","o":["아! 이런 젠장, 나도 까먹었네"]},{"k":"reply","o":["너 때문이잖아"]},{"k":"msg","t":"그게 왜 나 때문이냐","n":"단희","c":"CH0020"},{"k":"reply","o":["니가 허접이라 까먹어버렸잖아"]},{"k":"msg","t":"그렇게 음탕한 발언으로 나를 유혹해 놓고는","n":"단희","c":"CH0020"},{"k":"reply","o":["너야말로 그렇게 엉망진창으로 덮쳐놓고선"]},{"k":"msg","t":"...","n":"단희","c":"CH0020"},{"k":"msg","t":"그럼 술은 계속 아껴두도록 하지","n":"단희","c":"CH0020"},{"k":"msg","t":"조만간 만나서 잔을 나누자꾸나♡","n":"단희","c":"CH0020"}],"story":[{"k":"text","lines":[{"k":"place","t":"천등가"},{"k":"line","t":"어라? 상품이 다 떨어졌잖아!? 거기 누구 없어요~?","n":"가게 상인1","c":"SC0213"},{"k":"line","t":"오오! 창고에서 가져다주면 되나?","n":"단희","c":"CH0020"},{"k":"line","t":"여기~! 아무나 도와줘~! 배달해야 할 물건이 너무 많아!","n":"가게 상인2","c":"SC0214"},{"k":"line","t":"알았다! 잠시만 기다리거라~!","n":"단희","c":"CH0020"},{"k":"line","t":"...","n":"단희","c":"CH0020"},{"k":"line","t":"후우~ 아, 벗아. 언제 왔느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"방금. 바쁜 거 같은데?","n":"나"},{"k":"line","t":"후후, 이게 난 가문의 축제란다.","n":"단희","c":"CH0020"},{"k":"line","t":"정신없고, 바쁘고, 소란스럽지.","n":"단희","c":"CH0020"},{"k":"line","t":"그래도 곧 끝날 것 같으니- 먼저 화평루에서 기다려 주겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"니가 사는 거지?","n":"나"},{"k":"line","t":"하핫! 물론이다. 벗을 기다리게 하니 그 정도는 해야 하지 않겠나.","n":"단희","c":"CH0020"},{"k":"narration","t":"금방 온다던 단희는 꽤 시간이 지나서야 나타났다."},{"k":"place","t":"화평루"},{"k":"line","t":"이런, 이런... 미안하구나, 벗아. 예상보다 도울 일이 많아서 말이다.","n":"단희","c":"CH0020"},{"k":"line","t":"그렇게 열심히 할 필요가 있어? 어차피 술도 돌려받았잖아.","n":"나"},{"k":"line","t":"그러게 말이다. 못된 녀석들, 봉인만 아니었어도 벗과 함께 느긋하게 풍월을...","n":"단희","c":"CH0020"},{"k":"line","t":"그것 때문은 아닌 거 같은데.","n":"나"},{"k":"line","t":"너, 즐거워 보인단 말이지.","n":"나"},{"k":"line","t":"...후.","n":"단희","c":"CH0020"},{"k":"line","t":"하하, 하하핫!!","n":"단희","c":"CH0020"},{"k":"line","t":"역시, 벗을 속일 수는 없구나.","n":"단희","c":"CH0020"},{"k":"line","t":"그걸 이제 알았어?","n":"나"},{"k":"line","t":"너- 애초에 봉인도 스스로 풀 수 있다며.","n":"나"},{"k":"line","t":"벗아, 너는 저 아이들을 보며 무슨 생각이 드느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"...글쎄, 즐거워 보인다?","n":"나"},{"k":"line","t":"그렇구나, 그러면 저 아이들은?","n":"단희","c":"CH0020"},{"k":"line","t":"장사라도 준비하는 건가? 활기찬걸.","n":"나"},{"k":"line","t":"그래, 아마도 할로윈 축제를 준비 중인 거겠지.","n":"단희","c":"CH0020"},{"k":"line","t":"그래서 저게 뭐?","n":"나"},{"k":"line","t":"사랑스럽지 않으냐?","n":"단희","c":"CH0020"},{"k":"line","t":"뭐?","n":"나"},{"k":"line","t":"바람 따라, 구름 따라 수많은 길을 걸었다.","n":"단희","c":"CH0020"},{"k":"line","t":"온갖 것을 보고, 온갖 사람을 만났지.","n":"단희","c":"CH0020"},{"k":"line","t":"깨끗한 것만 있는 건 아니었단다. 때로는 지저분하고, 더러운 것들도 있었어.","n":"단희","c":"CH0020"},{"k":"line","t":"하지만 벗아. 그럼에도 불구하고.","n":"단희","c":"CH0020"},{"k":"line","t":"세계는 충분히 아름다운 것들로 가득했단다.","n":"단희","c":"CH0020"},{"k":"line","t":"그러니, 사랑하지 않고 배길 수 있겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"그런데 말이다, 벗아. 너는 또 다르더구나.","n":"단희","c":"CH0020"},{"k":"line","t":"뭐가?","n":"나"},{"k":"line","t":"가문에 속하고, 풍월회에 속해 사람들과 축제를 즐길 때는 그저 즐거울 뿐이었다.","n":"단희","c":"CH0020"},{"k":"line","t":"허나 벗을 만나고, 네 곁에 있으면서... 즐거움과는 다른 감정이 피어나더구나.","n":"단희","c":"CH0020"},{"k":"line","t":"가슴 속에서 올라오는 듯한 뜨거움이, 처음으로 어딘가에 머무르고 싶다는 마음이.","n":"단희","c":"CH0020"},{"k":"line","t":"후후... 바람 따라, 구름 따라 떠돌던 내가 한곳에 머무르고자 하는 마음이 생겨 버리다니.","n":"단희","c":"CH0020"},{"k":"line","t":"이제 풍류인이라는 말은 그만해야 할지도 모르겠구나.","n":"단희","c":"CH0020"},{"k":"line","t":"왜 그만 해야 하는데?","n":"나"},{"k":"line","t":"!?","n":"단희","c":"CH0020"},{"k":"line","t":"네가 말하는 그 풍류라는 건, 겨우 한곳에 머무른다고 없어질 종류의 무언가야?","n":"나"},{"k":"line","t":"평소에 뻔뻔한 낯짝으로 들이밀면서 이것이 풍류다! 라고 하는 게 너 아니었냐고.","n":"나"},{"k":"line","t":"날 변명거리로 삼지 마.","n":"나"},{"k":"line","t":"정말, 보면 볼수록 터무니없는 녀석이로구나.","n":"단희","c":"CH0020"},{"k":"line","t":"이건 네가 잘못한 거란다.","n":"단희","c":"CH0020"},{"k":"line","t":"그런 말로 내 마음을 뒤흔들다니.","n":"단희","c":"CH0020"},{"k":"line","t":"?! 야, 내가 뭘 했다고-","n":"나"},{"k":"line","t":"그러고 보니 저번에는 잘도 이 몸을 농락해 주었겠다?","n":"단희","c":"CH0020"},{"k":"line","t":"그 좁은 창고에서- 내 몸을 매만지던 네 손길이 아직도 잊혀지지 않는구나.","n":"단희","c":"CH0020"},{"k":"line","t":"복수라기엔 뭐하지만... 네 몸은 얼마나 버틸 수 있을까?","n":"단희","c":"CH0020"},{"k":"line","t":"야! 이런 곳에서 뭘 하려고!? 사람들이-","n":"나"},{"k":"line","t":"걱정 말거라. 이미 사람은 물렀으니... 오기 전에 이야기해 두었단다.","n":"단희","c":"CH0020"},{"k":"line","t":"이제 여기 있는 건 벗과 나뿐이란 말이지♡","n":"단희","c":"CH0020"},{"k":"line","t":"...날 낚았구나!","n":"나"},{"k":"line","t":"후후... 낚은 것인지, 낚인 것인지... 낚시꾼인건지, 물고기인건지...","n":"단희","c":"CH0020"},{"k":"line","t":"어디 한번 확인해 보자꾸나.","n":"단희","c":"CH0020"}]},{"k":"scene","kind":"affection"},{"k":"text","lines":[{"k":"place","t":"화평루"},{"k":"line","t":"어우, 간지러워 죽는 줄 알았네.","n":"나"},{"k":"line","t":"그럼 나의 승리로 봐도 되겠느냐?","n":"단희","c":"CH0020"},{"k":"line","t":"? 무슨 소리야. 난 졌다고 한 적 없는데.","n":"나"},{"k":"line","t":"그래?","n":"단희","c":"CH0020"},{"k":"line","t":"얍♡","n":"단희","c":"CH0020"},{"k":"line","t":"크읏!?","n":"나"},{"k":"line","t":"그렇게 말해도 몸은 정직하구나♡","n":"단희","c":"CH0020"},{"k":"line","t":"누구 때문인데!","n":"나"},{"k":"line","t":"...아니, 설마 이 정도일 줄은 몰랐어. 대체 유령의 집에서는 어떻게 버틴 거야?","n":"나"},{"k":"line","t":"후후... 그걸 즐기는 것 또한 풍류가 아니겠나?","n":"단희","c":"CH0020"},{"k":"line","t":"이젠 별게 다 풍류네.","n":"나"},{"k":"line","t":"내게는 벗과 함께하는 모든 것이 풍류란다.","n":"단희","c":"CH0020"},{"k":"line","t":"흥... 뭐, 좋아. 그럼 이번에는 무승부라고 치고...","n":"나"},{"k":"line","t":"다음에는 네가 본적도 없는 걸로 승부해야겠어.","n":"나"},{"k":"line","t":"그때 돼서 울고불고해도 안 봐줄 거야.","n":"나"},{"k":"line","t":"흐응~ 그 말은 다음에는 이길 자신이 있다는 말 이렸다?","n":"단희","c":"CH0020"},{"k":"line","t":"당연하지. 아무래도 넌 주기적으로 허접인 걸 주지시켜 줘야 하는 것 같으니까.","n":"나"},{"k":"line","t":"?!","n":"단희","c":"CH0020"},{"k":"line","t":"후, 후후... 하하핫!","n":"단희","c":"CH0020"},{"k":"line","t":"그래, 기대하마. 벗아.","n":"단희","c":"CH0020"},{"k":"line","t":"네가 나를 허접으로 만들어 줄 그날을 말이지...♡","n":"단희","c":"CH0020"}]}]}}}
