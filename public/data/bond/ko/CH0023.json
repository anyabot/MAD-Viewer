"네 팬티 줘."},{"k":"choice","t":"네 스타킹 줘."},{"k":"line","t":"뭐야, 겨우 그거면 돼?","n":"로나","c":"CH0023"},{"k":"line","t":"맘대로 해. 입고 있던 걸로 주지 뭐.","n":"로나","c":"CH0023"},{"k":"line","t":"화끈한데?","n":"나"},{"k":"line","t":"원래 영업 잘하려면 화끈해야 해.","n":"로나","c":"CH0023"},{"k":"line","t":"오, 방금은 조금 멋졌다. 응. 파업 종료. 정상 영업 시작.","n":"나"},{"k":"line","t":"그래. 잘 하자?","n":"로나","c":"CH0023"},{"k":"line","t":"휴우. 두부가 이제 절반 밖에 안 남았어.","n":"로나","c":"CH0023"},{"k":"line","t":"…절반이나 남은 게 아닐까?","n":"나"},{"k":"place","t":"두부거리"},{"k":"line","t":"이제 곧 해가 지겠네. 더 이상 영업하기 힘들 거야.","n":"나"},{"k":"line","t":"분명히 말하는데. 이 두부 다 돌릴 때까지 영업은 계속할 거야.","n":"로나","c":"CH0023"},{"k":"line","t":"이런 젠장. 또 파업해야 할 거 같은데.","n":"나"},{"k":"line","t":"아까 보너스 준다고 했잖아!!","n":"로나","c":"CH0023"},{"k":"line","t":"그건 그거고 이건 이거지. 더 내놔.","n":"나"},{"k":"line","t":"어휴, 진짜… 너, 한번 -","n":"로나","c":"CH0023"},{"k":"line","t":"어어?","n":"로나","c":"CH0023"},{"k":"line","t":"내 두부가… 내 두부가… 다 쏟아졌어!","n":"로나","c":"CH0023"},{"k":"line","t":"크아아아아, 용서 못 해!!!","n":"로나","c":"CH0023"},{"k":"line","t":"죽어! 죽어라! 이 자식들!","n":"로나","c":"CH0023"},{"k":"line","t":"…조졌네 이거. 파노티콘 바로 앞에서…","n":"나"}]}]},"2312":{"chat":[{"k":"msg","t":"어디쯤이야?","n":"로나","c":"CH0023"},{"k":"reply","o":["응? 뭐가?"]},{"k":"msg","t":"나 오늘 출소잖아!","n":"로나","c":"CH0023"},{"k":"reply","o":["아, 맞다 미안"]},{"k":"msg","t":"미안이라니? 장난치지마","n":"로나","c":"CH0023"},{"k":"reply","o":["까먹고 있었어 난 다시 자러 갈게"]},{"k":"msg","t":"야! 야!","n":"로나","c":"CH0023"},{"k":"reply","o":["농담이야"]},{"k":"msg","t":"죽을래?! 보너스 안 준다?!","n":"로나","c":"CH0023"},{"k":"reply","o":["아 좀 농담이랬잖아"]},{"k":"story"},{"k":"msg","t":"야 탈옥범","n":"로나","c":"CH0023"},{"k":"reply","o":["말 걸지 마"]},{"k":"msg","t":"너 은근히 속 좁은 거 알지?","n":"로나","c":"CH0023"},{"k":"msg","t":"그래도, 도와줘서 고마웠다","n":"로나","c":"CH0023"},{"k":"msg","t":"다음에도 나랑 같이 두부 영업 하는 거다?","n":"로나","c":"CH0023"},{"k":"msg","t":"보너스의 보너스의 보너스는 어때","n":"로나","c":"CH0023"},{"k":"msg","t":"야","n":"로나","c":"CH0023"},{"k":"msg","t":"야 씹냐??","n":"로나","c":"CH0023"},{"k":"reply","o":["아 쫌!!"]}],"story":[{"k":"text","lines":[{"k":"place","t":"두부 거리"},{"k":"line","t":"후… 출소하기 딱 좋은 날이구만.","n":"로나","c":"CH0023"},{"k":"line","t":"어이!","n":"나"},{"k":"line","t":"어서 오고. 두부 가져왔어?","n":"로나","c":"CH0023"},{"k":"line","t":"그럼 그럼.","n":"나"},{"k":"line","t":"탱글탱글하네. 역시 내가 기른 콩으로 만든 두부야.","n":"로나","c":"CH0023"},{"k":"line","t":"자, 이거 먹어.","n":"로나","c":"CH0023"},{"k":"line","t":"가, 감사합니다!","n":"프로틴두부연합단원1","c":"NP0203"},{"k":"line","t":"프로틴이다! 잘 먹겠습니다!","n":"프로틴두부연합단원2","c":"NP0212"},{"k":"line","t":"천천히 먹어라. 그러다 체한다.","n":"로나","c":"CH0023"},{"k":"line","t":"네, 넵!","n":"프로틴두부연합단원1","c":"NP0203"},{"k":"line","t":"우걱, 우걱.","n":"프로틴두부연합단원2","c":"NP0212"},{"k":"line","t":"어? 저번에 싸웠던 그 친구들이잖아?","n":"나"},{"k":"line","t":"나한테 두부 가져오라고 한 이유가 얘네들 먹이려고 한 거였어?","n":"나"},{"k":"line","t":"그래. 나랑 같은 방에 투옥돼서 그동안 참교육 좀 시켜줬지.","n":"로나","c":"CH0023"},{"k":"line","t":"이제 다들 새사람이 된 거야.","n":"로나","c":"CH0023"},{"k":"line","t":"깨끗하게 다시 태어나려면 세상에서 제일 맛있고 깨끗한 우리 가게 두부를 먹여야 하지 않겠어?","n":"로나","c":"CH0023"},{"k":"line","t":"이거야말로 진정한 두부 영업이지.","n":"로나","c":"CH0023"},{"k":"line","t":"너희들!","n":"로나","c":"CH0023"},{"k":"line","t":"히익!","n":"프로틴두부연합단원1","c":"NP0203"},{"k":"line","t":"이제부터 앞 잘 보고 다녀! 사람 물건 막 박살 내지 말고!","n":"로나","c":"CH0023"},{"k":"line","t":"(아무리 봐도 쌍방인데.)","n":"나"},{"k":"line","t":"그런 거 보이면 내가 또 혼내주러 간다!","n":"로나","c":"CH0023"},{"k":"line","t":"넵! 알겠습니다!","n":"프로틴두부연합단원2","c":"NP0212"},{"k":"line","t":"집에 가.","n":"로나","c":"CH0023"},{"k":"line","t":"아, 안녕히 계세요!","n":"프로틴두부연합단원1","c":"NP0203"},{"k":"line","t":"엄청 빨리 도망가네.","n":"나"},{"k":"line","t":"진짜 이대로 보내도 괜찮겠어? 네 두부를 못쓰게 만든 녀석들인데.","n":"나"},{"k":"line","t":"…잘 모르겠어.","n":"로나","c":"CH0023"},{"k":"line","t":"그래도, 누군가 우리 가게 두부 먹는 모습을 보는 건 역시 기분 좋은 일이야.","n":"로나","c":"CH0023"},{"k":"line","t":"사실 나, 파노티콘에 있으면서 고민했었어.","n":"로나","c":"CH0023"},{"k":"line","t":"항상 적자만 나는 무리한 영업을 계속 해야만 하는 건지.","n":"로나","c":"CH0023"},{"k":"line","t":"그래서?","n":"나"},{"k":"line","t":"그러던 와중, 저 녀석들에게 반드시 우리 가게의 두부 맛을 선보여야겠다는 생각이 들었거든?","n":"로나","c":"CH0023"},{"k":"line","t":"처음에는 너희가 박살낸 두부가 이렇게 귀한 물건이라는 것을 알려주고 싶었어. 근데…","n":"로나","c":"CH0023"},{"k":"line","t":"방금 쟤네가 두부를 맛있게 먹는 걸 보고 깨달았어.","n":"로나","c":"CH0023"},{"k":"line","t":"나는 이런 걸 보고 싶어서 두부 영업을 계속해 왔구나, 하는 사실을 말야.","n":"로나","c":"CH0023"},{"k":"line","t":"방금은 억지로 먹인 거 아니었어?","n":"나"},{"k":"line","t":"조용히 좀 해줄래? 내 감동을 박살 내지 말아 줘.","n":"로나","c":"CH0023"},{"k":"line","t":"아무튼, 내가 일전에 말했던 ‘강렬한 맛’ 있잖아?","n":"로나","c":"CH0023"},{"k":"line","t":"그게 이런 게 아닌가 싶어.","n":"로나","c":"CH0023"},{"k":"line","t":"입으로 느끼는게 아닌, 마음으로 느끼는 맛.","n":"로나","c":"CH0023"},{"k":"line","t":"그래서 고민 더 안하고, 그냥 하던 대로 하려고!!","n":"로나","c":"CH0023"},{"k":"line","t":"대책없이 긍정적이네.","n":"나"},{"k":"line","t":"그런데… 혹시 결선 심사위원에 대해 들은 이야기는 없어?","n":"나"},{"k":"line","t":"딱히? 하지만 영업은 계속해야 하겠지.","n":"로나","c":"CH0023"},{"k":"line","t":"혹시 모르잖아? 진짜 파노티콘에 납품하게 될지.","n":"로나","c":"CH0023"},{"k":"line","t":"어 그래. 열심히 해.","n":"나"},{"k":"line","t":"난 할 만큼 했으니까, 빨리 의뢰비랑 보너스 줘.","n":"나"},{"k":"line","t":"무슨 소리야? 아직 영업이 끝나지 않았는데.","n":"로나","c":"CH0023"},{"k":"line","t":"우리 계약은 영업이 끝난 이후에 이행되는 거 아니었어?","n":"로나","c":"CH0023"},{"k":"line","t":"하… 이럴 줄 알았다.","n":"나"},{"k":"line","t":"헤헤. 나랑 하루만 더 고생해줘.","n":"로나","c":"CH0023"},{"k":"line","t":"그럼 더 큰 보너스가 있을지도 몰라.","n":"로나","c":"CH0023"},{"k":"line","t":"그럼 나랑 조금만 더 같이 일하는 거다? 알겠지?","n":"로나","c":"CH0023"},{"k":"line","t":"안 해!","n":"나"}]}]}}}
