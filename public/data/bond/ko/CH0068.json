{"chats":{"6801":{"chat":[{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"바빠?","n":"클레어","c":"CH0068"},{"k":"reply","o":["어 뭐야"]},{"k":"reply","o":["통신 복구됐나 보네"]},{"k":"msg","t":"응","n":"클레어","c":"CH0068"},{"k":"msg","t":"바빠?","n":"클레어","c":"CH0068"},{"k":"reply","o":["지금 객실로 돌아가는 중이긴 한데"]},{"k":"reply","o":["왜 뭔일 있냐?"]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"그럼 얼른 와","n":"클레어","c":"CH0068"},{"k":"msg","t":"몸의 대화 하자","n":"클레어","c":"CH0068"},{"k":"reply","o":["?????"]},{"k":"story"},{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"몸은 좀 괜찮아?","n":"클레어","c":"CH0068"},{"k":"msg","t":"미안 힘 조절을 잘못했어","n":"클레어","c":"CH0068"},{"k":"reply","o":["죽는 줄 알았다 이 자식아!!!"]},{"k":"msg","t":"미안해","n":"클레어","c":"CH0068"},{"k":"msg","t":"다음에는 잘 할게","n":"클레어","c":"CH0068"},{"k":"reply","o":["다음? 다음이 어딨어? 그런 건 없어"]},{"k":"msg","t":"그동안은 혼자서 연습하고 있을게","n":"클레어","c":"CH0068"},{"k":"msg","t":"보기만 하는 거랑 직접 하는 거랑은 많이 다르네","n":"클레어","c":"CH0068"},{"k":"msg","t":"조금만 기다려줘","n":"클레어","c":"CH0068"},{"k":"reply","o":["이보쇼 다음은 없다니까?"]}],"story":[{"k":"text","lines":[{"k":"place","t":"알케트라즈"},{"k":"narration","t":"여기는 메이드장의 초호화 호텔 리조트 섬 알케트라즈."},{"k":"narration","t":"아, 착각하지 말자. 어디까지나 원인 모를(?) 해일이 덮치면서 이렇게 된 거니까."},{"k":"narration","t":"이런 어려운 여건 속에서도, 전 메이드 일동은 한마음 한뜻(?)이 되어 복구 작업을 시작했다."},{"k":"narration","t":"물론 일부 몰지각한 메이드들이 소동을 일으키는 일도 있었는데, 그것도 사랑과 우정의 이름으로 처단― 아니, 해결했다."},{"k":"narration","t":"그렇게 아무런 문제 없이, 순조롭게 복구를 이어가던 어느 날..."},{"k":"line","t":"......","n":"클레어","c":"CH0068"},{"k":"line","t":"흐아암.","n":"클레어","c":"CH0068"},{"k":"line","t":"......아.","n":"클레어","c":"CH0068"},{"k":"line","t":"일해야지.","n":"클레어","c":"CH0068"},{"k":"line","t":"......어요?","n":"???","c":"NP0708"},{"k":"line","t":"...응?","n":"클레어","c":"CH0068"},{"k":"line","t":"무슨 소리가 들렸는데.","n":"클레어","c":"CH0068"},{"k":"place","t":"모래사장"},{"k":"line","t":"그러고 보니, 그 소문 들었어요?","n":"메이드 A","c":"NP0708"},{"k":"line","t":"네? 무슨 소문이요?","n":"메이드 B","c":"NP0706"},{"k":"line","t":"왜, 그 탈옥수 주인님 있잖아요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"갑자기 뿅 하고 나타나서는 저희 모두에게 복구 작업을 시키신 분 말이에요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"에, 복구 작업은 언니가 시킨 거 아니었나요?","n":"메이드 B","c":"NP0706"},{"k":"line","t":"<bouten>표면상</bouten>으로는 그렇죠. 하지만 실제로는 이미 그 주인님한테 함락당했다는 게 정설이에요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"게다가 언니뿐만 아니라, 저희 같은 일반 메이드들 중에도 그 분한테 함락된 사람이 많다 하고요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"하, 함락...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"어쨌든, 그 주인님이 적지 않은 메이드 동료들을 포섭했다는 건 확실해요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"그러니까 자기편을 앞세워서, 저희 모두에게 복구 작업을 시킬 수도 있었던 거죠.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"타, 탈옥수 주인님이 그런 무서운 일을 한 거라고요?!","n":"메이드 B","c":"NP0706"},{"k":"line","t":"진실은 그 사람만 알겠죠.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"아무튼, 중요한 건 지금부터예요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"그렇다면 도대체... 어떤 방법으로 함락시켰을까?","n":"메이드 A","c":"NP0708"},{"k":"line","t":"(꿀꺽...)","n":"메이드 B","c":"NP0706"},{"k":"line","t":"이건 그 주인님에게 함락된 메이드한테서 직접 들은 얘기라는데...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"자신을 눈뜨게 한 건 되게 평범한 <bouten>마사지</bouten>였대요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"......마사지?","n":"메이드 B","c":"NP0706"},{"k":"line","t":"네, 이상하죠?","n":"메이드 A","c":"NP0708"},{"k":"line","t":"그런데 돌이켜 생각해 보면 평범한 마사지랑은 완전 달랐다네요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"말로는 설명하기 힘든데... 어, 엄청 기분이 좋다던가...?","n":"메이드 A","c":"NP0708"},{"k":"line","t":"아무튼 직접 경험해보는 게 빠르대요. 그 <bouten>몸의 대화</bouten>라는 걸 말이죠.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"모, 몸의 대화...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"그래요, 그 특별한 마사지를 몸의 대화라고 하는데...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"직접 받아봤다는 메이드 말에 따르면...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"그그그그런 것까지 하는 거예요?!","n":"메이드 B","c":"NP0706"},{"k":"line","t":"여기서 끝이 아니고...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"......그런 일이 있었어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그러니까 나한테 몸의 대화를 가르쳐줘.","n":"클레어","c":"CH0068"},{"k":"line","t":"......대체 나에 대해 뭔 소문이 돌고 있는 거냐?","n":"나"},{"k":"line","t":"후... 뭐 아무튼, 그런 거였나. 난 또... 괜히 뛰어왔네.","n":"나"},{"k":"line","t":"뛰어왔어? 왜?","n":"클레어","c":"CH0068"},{"k":"line","t":"됐고, 일단 무슨 얘기인지는 알겠다.","n":"나"},{"k":"line","t":"근데 그거랑 몸의 대화를 가르쳐달라는 거랑 무슨 상관이 있는 거냐?","n":"나"},{"k":"line","t":"......음.","n":"클레어","c":"CH0068"},{"k":"line","t":"비밀이야.","n":"클레어","c":"CH0068"},{"k":"line","t":"...?","n":"나"},{"k":"line","t":"전에 메이드들 잡으러 갔을 때 약속했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"해결사가 하라는 대로 잘하면 가르쳐준다고. 기억하지?","n":"클레어","c":"CH0068"},{"k":"line","t":"그 마사지란 걸 해주면 내 말을 고분고분 듣게 되는 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"...참고삼아 묻는 건데, 누구한테 해주려고?","n":"나"},{"k":"line","t":"...음.\n비밀.","n":"클레어","c":"CH0068"},{"k":"line","t":"너 이 자식, 무슨 꿍꿍이를...","n":"나"},{"k":"line","t":"...뭐, 내가 하라는 대로 잘하면 못 가르쳐줄 것도 없지만.","n":"나"},{"k":"line","t":"응, 열심히 할게.","n":"클레어","c":"CH0068"},{"k":"line","t":"아니, 뭐 그건... 그랬던가? 기억이 가물가물하네...","n":"나"},{"k":"line","t":"나 열심히 했으니까 가르쳐줘.","n":"클레어","c":"CH0068"},{"k":"line","t":"......에휴, 그래. 꺼낸 말은 지켜야지.","n":"나"},{"k":"line","t":"대신.","n":"나"},{"k":"line","t":"기왕 배우기로 했으니, 너도 각오 단단히 해라.","n":"나"},{"k":"line","t":"몸의 대화... 뭐 이름은 그런 걸로 치고... 어쨌든 그건 이 세계에 오고 나서 몇 번이고 나를 구한 기술이라고.","n":"나"},{"k":"line","t":"즉, 몸을 그냥 아무렇게나 주물럭거리는 거랑은 천지 차이란 말이다.","n":"나"},{"k":"line","t":"그런 극도로 섬세한 기술을 배운다는 건데... 그만한 각오는 됐겠지?","n":"나"},{"k":"line","t":"응. 열심히 할게.","n":"클레어","c":"CH0068"},{"k":"line","t":"널 따라다니면서 예습도 많이 했으니까.","n":"클레어","c":"CH0068"},{"k":"line","t":"...아, 뭐. 그렇긴 하군...","n":"나"},{"k":"line","t":"그럼 뭐, 한번 실력 구경 좀 해볼까?","n":"나"},{"k":"line","t":"응. 나한테 맡겨.","n":"클레어","c":"CH0068"},{"k":"line","t":"어때 해결사? 나 잘하고 있어?","n":"클레어","c":"CH0068"},{"k":"line","t":"......! 큭!! 이, 이건...!!!","n":"나"},{"k":"line","t":"그동안 네가 하는 걸 계속 보고 있었으니까.","n":"클레어","c":"CH0068"},{"k":"line","t":"어때? 나한테 함락된 것 같아?","n":"클레어","c":"CH0068"},{"k":"line","t":"......어어.","n":"나"},{"k":"line","t":"......! 해결사, 방금 뭐라고―","n":"클레어","c":"CH0068"},{"k":"line","t":"죽어어...! 죽는다고...!!","n":"나"},{"k":"line","t":"끄어어억! 모, 몸이...!! 몸이 비명을 지른다악!!","n":"나"},{"k":"line","t":"메, 메딕...!! 메딕!!!","n":"나"},{"k":"narration","t":"그 후, 의료실에서 엉망진창 치료받았다."}]}]},"6806":{"chat":[{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"오늘도 고생 많았어","n":"클레어","c":"CH0068"},{"k":"msg","t":"내가 마사지해줄까?","n":"클레어","c":"CH0068"},{"k":"reply","o":["기어코 날 죽일 생각인 거냐?"]},{"k":"msg","t":"그런 생각은 하지 않았어","n":"클레어","c":"CH0068"},{"k":"reply","o":["너 솔직하게 말해라"]},{"k":"reply","o":["누구의 사주를 받고 이러는 건데?"]},{"k":"msg","t":"?","n":"클레어","c":"CH0068"},{"k":"msg","t":"그런 거 없어","n":"클레어","c":"CH0068"},{"k":"msg","t":"그냥 내가 하고 싶","n":"클레어","c":"CH0068"},{"k":"reply","o":["?"]},{"k":"reply","o":["왜 말을 하다 마냐? 불안하게"]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"아무것도 아니야","n":"클레어","c":"CH0068"},{"k":"msg","t":"그리고 이번에는 나 진짜 자신 있어","n":"클레어","c":"CH0068"},{"k":"msg","t":"메이드들한테 해보면서 요령을 알았거든","n":"클레어","c":"CH0068"},{"k":"reply","o":["메이드?"]},{"k":"story"},{"k":"reply","o":["아까 얘기했던 대로, 준비되면 연락하마"]},{"k":"reply","o":["오늘 했던 그 감각 잊어버리지 말라고"]},{"k":"reply","o":["힘 조절은 딱 그 정도를 기준으로 하면 될 것 같으니까"]},{"k":"msg","t":"응","n":"클레어","c":"CH0068"},{"k":"msg","t":"메이드들한테 계속 연습하고 있을게","n":"클레어","c":"CH0068"},{"k":"reply","o":["엄... 그래 뭐 너무 겁주지는 말고"]},{"k":"reply","o":["근데 왜 그렇게 너만 보면 다들 도망간다냐?"]},{"k":"reply","o":["아 설마 전에 메이드들 잡으러 다녔을 때 소문이 난 건가?"]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"그럴지도","n":"클레어","c":"CH0068"},{"k":"msg","t":"그래도 괜찮아 내가 더 빠르니까","n":"클레어","c":"CH0068"},{"k":"reply","o":["그러면 더 쫄 것 같으니까 천천히 가라..."]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"확인","n":"클레어","c":"CH0068"}],"story":[{"k":"text","lines":[{"k":"place","t":"알케트라즈"},{"k":"narration","t":"여기는 메이드장의 초호화 호텔 리조트 섬 알케트라즈."},{"k":"narration","t":"베르몬트 바다 위에 있는, 섬의 모든 직원이 메이드로 이루어진...... 아, 이건 이미 했었나."},{"k":"narration","t":"아무튼, 복구 작업은 순조롭게 진행중이지만... 얼마 전 생존의 위기를 겪고 생각이 많아지던 무렵..."},{"k":"place","t":"수리 중인 리조트 입구"},{"k":"line","t":"......","n":"클레어","c":"CH0068"},{"k":"line","t":"하아, 메이드 잡으러 다닐 때가 편하고 좋았는데...","n":"나"},{"k":"line","t":"에휴... 어쩌겠어, 내 팔자가 이렇지 뭐...","n":"나"},{"k":"narration","t":"......어요?"},{"k":"line","t":"...엉?","n":"나"},{"k":"line","t":"누가 하라는 일은 안 하고 떠드는 거야?","n":"나"},{"k":"place","t":"모래사장"},{"k":"line","t":"그러고 보니, 그 소문 들었어요?","n":"메이드 A","c":"NP0708"},{"k":"line","t":"네? 또 어떤 소문이...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"왜, 전에 말한 몸의 대화 있잖아요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"탈옥수 주인님이 언니나 메이드 동료들을 함락시킬 때 사용했다는...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"아... 네, 네에.","n":"메이드 B","c":"NP0706"},{"k":"line","t":"닿은 곳은 마치 전기가 통한 것처럼 찌릿거리고...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"온몸이 점점 주체할 수 없을 만큼 뜨거워진다는 그...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"어... 뭐, 그렇죠. 자세하게 기억하고 계시네요...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"평소에는 소문에 별로 관심 없으신 것 같았는데.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"그그그그게!! 어, 어쩌다 보니...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"아, 아무튼! 그 몸의 대화가 왜, 왜요...?","n":"메이드 B","c":"NP0706"},{"k":"line","t":"실은... 최근에 그걸 미끼로 습격당했다는 메이드들이 있다고 하더라고요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"몸의 대화를 해주겠다면서 접근해서는, 이상하게 주물럭거리다 가버린다는...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"네, 네에에!!? 어, 어떻게 그런 심한 짓을...!!","n":"메이드 B","c":"NP0706"},{"k":"line","t":"(......)","n":"나"},{"k":"line","t":"그런데 이상한 건 다들 하나같이 범인이 누구인지는 밝히지 않는다는 거예요.","n":"메이드 A","c":"NP0708"},{"k":"line","t":"어쩌면 입막음을 당한 건지도...","n":"메이드 A","c":"NP0708"},{"k":"line","t":"그, 그런... 누군지 몰라도 정말 무시무시한 사람이네요...","n":"메이드 B","c":"NP0706"},{"k":"line","t":"......그래서, 어떻게 생각하냐?","n":"나"},{"k":"line","t":"그런 무시무시한 소문이 도는 범인에 대해, 짐작 가는 거 없어?","n":"나"},{"k":"line","t":"...음.","n":"클레어","c":"CH0068"},{"k":"line","t":"정당한 거래였어.","n":"클레어","c":"CH0068"},{"k":"line","t":"호오, 정면 돌파를 하겠다고?","n":"나"},{"k":"line","t":"그럼 뭐 어디 한번 들어나 볼까.","n":"나"},{"k":"line","t":"응. 그날 이후로 몸의 대화를 연습하려고 메이드들한테 해봤어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그런데 대부분 반응이 별로였고.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래서 나중에 완벽하게 익히고 나면 또 해주기로 했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"......응? 왜 생각보다 평범하지?","n":"나"},{"k":"line","t":"아니 그럼 습격당했다느니 입막음을 당했다느니 하는 말은 왜 나온 건데?","n":"나"},{"k":"line","t":"...음. 잘 모르겠는데.","n":"클레어","c":"CH0068"},{"k":"line","t":"솔직하게 불어. 구체적으로 뭘 어떻게 한 건데.","n":"나"},{"k":"line","t":"음, 그러니까 아까 전에는...","n":"클레어","c":"CH0068"},{"k":"line","t":"히이, 히이...! 흑, 아으...!! 후읏, 하아... 하아...","n":"겁먹은 메이드","c":"NP0706"},{"k":"line","t":"여, 여기까지 왔으면... 쪼, 쫓아오지 못할 거야... 흐, 아으...","n":"겁먹은 메이드","c":"NP0706"},{"k":"narration","t":"거기."},{"k":"line","t":"히야아아아악!!!!!!","n":"겁먹은 메이드","c":"NP0706"},{"k":"line","t":"도망, 곤란.","n":"클레어","c":"CH0068"},{"k":"line","t":"사, 살려주세요! 뭐, 뭐든 할 테니까요!!","n":"겁먹은 메이드","c":"NP0706"},{"k":"line","t":"...? 음, 그러면 한 가지만 도와줘.","n":"클레어","c":"CH0068"},{"k":"line","t":"몸의 대화를 연습 중인데, 너한테 해봐도 돼?","n":"클레어","c":"CH0068"},{"k":"line","t":"알겠습니다!! 그, 그러면 살려주시는 거죠?!","n":"겁먹은 메이드","c":"NP0706"},{"k":"line","t":"......?","n":"클레어","c":"CH0068"},{"k":"line","t":"음... 그래.","n":"클레어","c":"CH0068"},{"k":"line","t":"......그러고 나서, 어땠냐고 물어보니까 잘 모르겠대.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래서 나중에 완벽하게 익히고 나면 또 해주겠다고 했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그랬더니 아무한테도 말하지 않을 테니까 용서해 달라 하더라고.","n":"클레어","c":"CH0068"},{"k":"line","t":"말한 거랑 실제 상황이랑 너무 다르잖아 인마!!","n":"나"},{"k":"line","t":"호러 무비를 성장 드라마처럼 설명하지 말라고!","n":"나"},{"k":"line","t":"......음. 그래도 정말로 성장했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"이제 아프진 않을 거야. 메이드들한테 해보면서 요령을 알았거든.","n":"클레어","c":"CH0068"},{"k":"line","t":"해결사의 몸은 다른 사람들보다 약하니까, 그걸 많이 연습했어. 그러니까...","n":"클레어","c":"CH0068"},{"k":"line","t":"한 번만 더 기회를 줘.","n":"클레어","c":"CH0068"},{"k":"line","t":"...에휴, 그래. 알겠다.","n":"나"},{"k":"line","t":"대신 이번에도 양호실 행이면 이 수업도 여기서 끝이다. 오케이?","n":"나"},{"k":"line","t":"응.","n":"클레어","c":"CH0068"},{"k":"line","t":"해결사, 왜 이렇게 떨어? 추워?","n":"클레어","c":"CH0068"},{"k":"line","t":"내내가 언제 떨었다고. 얼른 시시작하기나 해.","n":"나"},{"k":"line","t":"해결사, 어때? 이제 안 아프지?","n":"클레어","c":"CH0068"},{"k":"line","t":"어? 어, 음... 그렇긴 한데...","n":"나"},{"k":"line","t":"기분은 어때? 나 잘하고 있어?","n":"클레어","c":"CH0068"},{"k":"line","t":"흠... 으음...","n":"나"},{"k":"line","t":"오케이, 잠깐 스톱.","n":"나"},{"k":"line","t":"응?","n":"클레어","c":"CH0068"},{"k":"line","t":"보자, 일단은... 그렇지.","n":"나"},{"k":"line","t":"전에 메이드들한테 해봤을 때는, 반응이 별로였다고 했지?","n":"나"},{"k":"line","t":"...응. 잘 모르겠다고 했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"걔들이 왜 그런 말을 했는지 대충 알겠더라고.","n":"나"},{"k":"line","t":"이번에 한 건 뭐랄까, 오히려 더 어정쩡했어.","n":"나"},{"k":"line","t":"힘 조절을 하는 것에 너무 사로잡혀서, 정작 중요한 <bouten>마사지</bouten>에 아무 느낌이 없었거든.","n":"나"},{"k":"line","t":"......아, 음.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래도 확실히 나아진 건 있군.","n":"나"},{"k":"line","t":"...응?","n":"클레어","c":"CH0068"},{"k":"line","t":"어쨌든 힘 조절은 확실하게 됐잖아.","n":"나"},{"k":"line","t":"이제 그 감각을 잊지 말고, 다음 스텝으로 넘어가자고.","n":"나"},{"k":"line","t":"......그럼, 계속해도 되는 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"뭐, 일단 양호실 행은 피했으니까.","n":"나"},{"k":"line","t":"싫냐? 싫으면 말고.","n":"나"},{"k":"line","t":"...아니. 나 계속하고 싶어.","n":"클레어","c":"CH0068"},{"k":"line","t":"......응. 계속하고 싶어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래, 칼을 뽑았으면 무라도 썰어야지.","n":"나"},{"k":"line","t":"응. 난 고기 썰래.","n":"클레어","c":"CH0068"},{"k":"line","t":"...어, 그래. 많이 썰어라.","n":"나"},{"k":"line","t":"그럼 이제 뭘 하면 돼, 해결사?","n":"클레어","c":"CH0068"},{"k":"line","t":"마사지 기술 같은 걸 배우면 되는 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"아니, 기술 같은 거 말고 더 중요한 게 있어.","n":"나"},{"k":"line","t":"어쩌면 마사지에서 가장 중요한 덕목일 수도 있지...","n":"나"},{"k":"line","t":"음. 그게 뭔데?","n":"클레어","c":"CH0068"},{"k":"line","t":"그건 바로...\n<bouten>마음</bouten>이다.","n":"나"},{"k":"line","t":"...?","n":"클레어","c":"CH0068"}]}]},"6812":{"chat":[{"k":"reply","o":["여어, 지금 어디냐?"]},{"k":"reply","o":["전에 말했던 그거 준비됐는데 오늘 할까?"]},{"k":"msg","t":"응","n":"클레어","c":"CH0068"},{"k":"msg","t":"지금 별관 C동 청소중이야","n":"클레어","c":"CH0068"},{"k":"msg","t":"금방 갈게 어디로 가면 돼?","n":"클레어","c":"CH0068"},{"k":"reply","o":["본관 입구에서 만나자고"]},{"k":"reply","o":["거기서 같이 가면 될듯"]},{"k":"msg","t":"확인","n":"클레어","c":"CH0068"},{"k":"story"},{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"몸은 좀 괜찮아?","n":"클레어","c":"CH0068"},{"k":"msg","t":"미안 아까는 내 몸이 말을 듣지 않았어","n":"클레어","c":"CH0068"},{"k":"msg","t":"해결사?","n":"클레어","c":"CH0068"},{"k":"reply","o":["메시지 전송에 실패했습니다."]}],"story":[{"k":"text","lines":[{"k":"place","t":"리조트 입구"},{"k":"line","t":"해결사, 나 왔어. 오물오물.","n":"클레어","c":"CH0068"},{"k":"line","t":"아니, 벌써...? 한 1분 지났는데?","n":"나"},{"k":"line","t":"별관 C동에서 여기까지 못해도 20분은 걸릴 텐데...?","n":"나"},{"k":"line","t":"응. 난 호문쿨루스니까.","n":"클레어","c":"CH0068"},{"k":"line","t":"육포 먹으면서 빨리 왔어.","n":"클레어","c":"CH0068"},{"k":"line","t":"...아. 난 또 내가 빨리 기다린 줄 알았네.","n":"나"},{"k":"line","t":"...? 빨리 기다린다고? 그건 어떻게 하는 건데?","n":"클레어","c":"CH0068"},{"k":"line","t":"다 그런 게 있어. 됐으니까 그냥 가기나 하자.","n":"나"},{"k":"line","t":"......음. 확인.","n":"클레어","c":"CH0068"},{"k":"place","t":"조용한 해변가"},{"k":"line","t":"...음. 해결사.","n":"클레어","c":"CH0068"},{"k":"line","t":"오늘 할 거라는 게 정확히 어떤 거야? 이제 알려줘도 되잖아.","n":"클레어","c":"CH0068"},{"k":"line","t":"오늘은...","n":"나"},{"k":"line","t":"제대로 된 마사지가 무엇인지, 보여줄 거다.","n":"나"},{"k":"line","t":"...응? 제대로 된 마사지?","n":"클레어","c":"CH0068"},{"k":"line","t":"그래, 전에 마사지에 있어서 가장 중요한 건 마음이라고 했었지.","n":"나"},{"k":"line","t":"메이드에게 있어 가장 중요한 <bouten>봉사 정신</bouten>과도 같은 마음가짐...","n":"나"},{"k":"line","t":"즉, 너도 메이드와도 같은 봉사 정신을 가져야 비로소 제대로 된 마사지를 할 수 있을 것이란 말이지.","n":"나"},{"k":"line","t":"......음. 무슨 말인지 잘 모르겠는데.","n":"클레어","c":"CH0068"},{"k":"line","t":"메이드에게 꼭 봉사 정신이 필요한 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"...그게 무슨 말이지? 논란이 될 수 있으니 주의해서 발언하도록.","n":"나"},{"k":"line","t":"음. 전에 해결사가 메이드에게 가장 중요한 건 팀워크 정신이라고 했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래서 다 같이 일하고 다 같이 놀아야 하니까 일을 안 하는 메이드는 잡아서―","n":"클레어","c":"CH0068"},{"k":"line","t":"오케이, 잡담은 거기까지.","n":"나"},{"k":"line","t":"지금 그런 사소한 것보다 중요한 게 있잖아!!","n":"나"},{"k":"line","t":"중요한 건 내가 너한테 마사지해 주면서,\n봉사 정신을 그 몸에 직접 새겨주겠단 거다!!","n":"나"},{"k":"line","t":"...음. 근데 그게 꼭 필요한가.","n":"클레어","c":"CH0068"},{"k":"line","t":"나는 내가 해주는 걸 배우고 싶은 건데.","n":"클레어","c":"CH0068"},{"k":"line","t":"무작정 하기만 해서 배울 수 있는 게 아니라고.","n":"나"},{"k":"line","t":"마사지... 아니지, 몸의 대화란 건 원래 주고 받는 게 기본이다!","n":"나"},{"k":"line","t":"음... 알았어. 네가 그렇게 말한다면.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래, 이게 다 너 잘 되라고 하는 거라고.","n":"나"},{"k":"line","t":"자, 이쪽이야. 여긴 수리도 다 끝나서 올 사람도 없을 테니까.","n":"나"},{"k":"line","t":"응.","n":"클레어","c":"CH0068"},{"k":"line","t":"근데 꼭 이런 곳에서 해야 하는 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"뭐, 방해받지 않는 곳이면 어디든 상관없긴 한데...","n":"나"},{"k":"line","t":"하다 보면 소리가 날 수도 있으니까.","n":"나"},{"k":"line","t":"......음. 소리?","n":"클레어","c":"CH0068"},{"k":"line","t":"뭐, 자세한 건 하면서 설명해 줄 테니까 가자고.","n":"나"},{"k":"line","t":"자, 여기 편하게 누운 상태로...","n":"나"},{"k":"line","t":"이렇게?","n":"클레어","c":"CH0068"},{"k":"line","t":"그리고 자세를, 이렇게 하면...","n":"나"}]},{"k":"scene","kind":"desire"},{"k":"text","lines":[{"k":"line","t":"흐읏... 하아, 하아...","n":"클레어","c":"CH0068"},{"k":"line","t":"어때, 몸의 대화를 나눈 소감은.","n":"나"},{"k":"line","t":"......으음.","n":"클레어","c":"CH0068"},{"k":"line","t":"메이드들이 말한 그대로였어.","n":"클레어","c":"CH0068"},{"k":"line","t":"마치 전기가 통한 것처럼 찌릿거리고... 온몸이 점점 뜨거워지는...","n":"클레어","c":"CH0068"},{"k":"line","t":"이게 몸의 대화인 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"그래. 이게 바로 진정한 몸의 대화란 거지.","n":"나"},{"k":"line","t":"몸의 대화라고 하지만, 문자 그대로 진짜 몸으로만 대화하는 게 아니라고.","n":"나"},{"k":"line","t":"메이드가 봉사하는 마음... 해결사가 나를 위하는 마음...","n":"클레어","c":"CH0068"},{"k":"line","t":"그런 마음까지 있어야 진정한 몸의 대화라는 거지?","n":"클레어","c":"CH0068"},{"k":"line","t":"훌륭하다. 이제 좀 감이 잡히냐?","n":"나"},{"k":"line","t":"응... 뭔가 알 것 같아.","n":"클레어","c":"CH0068"},{"k":"line","t":"해결사, 나 지금 한번 해봐도 돼?","n":"클레어","c":"CH0068"},{"k":"line","t":"어... 지금? 너무 무리하는 거 아니냐?","n":"나"},{"k":"line","t":"네가 그랬잖아. 몸의 대화는 원래 주고 받는 거라고.","n":"클레어","c":"CH0068"},{"k":"line","t":"그러니까 나도 해결사한테 해주고 싶어.","n":"클레어","c":"CH0068"},{"k":"line","t":"엄... 그, 너 일단 좀 진정하는 게...","n":"나"},{"k":"line","t":"나는 지금 그 어느 때보다 침착한 상태야, 해결사.","n":"클레어","c":"CH0068"},{"k":"line","t":"나도 지금 그 어느 때보다 생명의 위협을 느끼고 있어.","n":"나"},{"k":"line","t":"......해결사, 이 얘기는 나중에 다시 하자.","n":"클레어","c":"CH0068"},{"k":"line","t":"지금은 일단 빨게 해줘.","n":"클레어","c":"CH0068"},{"k":"line","t":"기, 기다렷―","n":"나"},{"k":"narration","t":"그 후, 침대 위에서 엉망진창 빨렸다."}]}]},"6816":{"chat":[{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"오늘 담당 구역 같은 곳이야","n":"클레어","c":"CH0068"},{"k":"reply","o":["안돼"]},{"k":"msg","t":"끝나고 같이 육포 먹을래?","n":"클레어","c":"CH0068"},{"k":"msg","t":"응?","n":"클레어","c":"CH0068"},{"k":"reply","o":["어차피 마사지 하게 해달라고 할 거잖아 이 자식아!!!"]},{"k":"reply","o":["이러다가 내가 먼저 죽겠다고"]},{"k":"reply","o":["왜 갑자기 힘 조절이 안된다는 거야"]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"모르겠어","n":"클레어","c":"CH0068"},{"k":"msg","t":"분명 평소대로 했는데","n":"클레어","c":"CH0068"},{"k":"msg","t":"근데 이번에는 진짜 다를 것 같아","n":"클레어","c":"CH0068"},{"k":"msg","t":"한번만 더 믿어줘","n":"클레어","c":"CH0068"},{"k":"reply","o":["하..."]},{"k":"reply","o":["진짜 이번이 찐찐막이다"]},{"k":"msg","t":"응?","n":"클레어","c":"CH0068"},{"k":"story"}],"story":[{"k":"text","lines":[{"k":"narration","t":"클레어에게 진정한 몸의 대화를 가르쳐준 날 이후..."},{"k":"place","t":"알케트라즈"},{"k":"line","t":"해결사, 오늘 밤에 괜찮아?","n":"클레어","c":"CH0068"},{"k":"line","t":"어, 음... 뭐 괜찮겠지.","n":"나"},{"k":"line","t":"그래도 적당히 해라. 내일도 일 나가야 하니까.","n":"나"},{"k":"line","t":"응.","n":"클레어","c":"CH0068"},{"k":"line","t":"크아악!! 메딕, 메딕!!","n":"나"},{"k":"narration","t":"그 다음에도..."},{"k":"line","t":"오늘은 정말 자신 있어. 새로운 방법을 떠올렸거든.","n":"클레어","c":"CH0068"},{"k":"line","t":"이번에는 발을 써서 해줄게.","n":"클레어","c":"CH0068"},{"k":"line","t":"발...? 뭐, 나쁘지 않은 생각인 것 같긴 한데...","n":"나"},{"k":"line","t":"...하아, 알겠다. 이번만이야.","n":"나"},{"k":"line","t":"크아아악!!! 메딕!!!","n":"나"},{"k":"narration","t":"그 다다음에도..."},{"k":"line","t":"해결사, 이번에는 진짜야.","n":"클레어","c":"CH0068"},{"k":"line","t":"아까 지나가는 히나타한테 해봤는데 괜찮았어.","n":"클레어","c":"CH0068"},{"k":"line","t":"아, 그래? 그럼 안심이고.","n":"나"},{"k":"line","t":"네? 뭐, 뭐가 안심이라는...","n":"히나타","c":"CH0031"},{"k":"line","t":"...저, 설마 시험대로 쓰였던 건 아니죠!!?","n":"히나타","c":"CH0031"},{"k":"line","t":"......! 이, 이건...!!","n":"나"},{"k":"line","t":"후후. 지금은 어때?","n":"클레어","c":"CH0068"},{"k":"line","t":"......어어. 진짜 괜찮아진 건가?","n":"나"},{"k":"line","t":"응. 널 기분 좋게 해주려고 엄청 열심히 생각했으니까.","n":"클레어","c":"CH0068"},{"k":"line","t":"뭉친 곳부터 풀어줄게. 위에서 아래로...","n":"클레어","c":"CH0068"},{"k":"line","t":"......윽.","n":"나"},{"k":"line","t":"헤헤... 여기가 기분 좋아?","n":"클레어","c":"CH0068"},{"k":"line","t":"계속 해줄테니까... 너는 편하게 있―","n":"클레어","c":"CH0068"},{"k":"line","t":"끄으윽... 끄아악...","n":"나"},{"k":"line","t":"메... 딕...","n":"나"},{"k":"line","t":"......아.","n":"메이드장","c":"NP0799"},{"k":"line","t":"......그런 일이 있었어.","n":"클레어","c":"CH0068"},{"k":"line","t":"......","n":"메이드장","c":"NP0799"},{"k":"line","t":"...으흠, 그러니까 혹시...","n":"메이드장","c":"NP0799"},{"k":"line","t":"자랑하러 오신 건가요...?","n":"메이드장","c":"NP0799"},{"k":"line","t":"...음. 아니.","n":"클레어","c":"CH0068"},{"k":"line","t":"도움이 필요해서 왔어.","n":"클레어","c":"CH0068"},{"k":"line","t":"제, 제 도움이요? 방금 말해주신 것 중에 제 도움이 필요한 게 어디―","n":"메이드장","c":"NP0799"},{"k":"line","t":"읏, 아아? 에에? 아아아니... 설마... 제, 제가 그... 가, 같이...?","n":"메이드장","c":"NP0799"},{"k":"line","t":"...? 무슨 말인지 잘 모르겠어.","n":"클레어","c":"CH0068"},{"k":"line","t":"같이? 같이 몸의 대화를 하고 싶다는 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"아아아아니그게아니라아니아닌건아닌데―!!!!!","n":"메이드장","c":"NP0799"},{"k":"line","t":"그, 방금 건 잊어주시면 좋겠어요...","n":"메이드장","c":"NP0799"},{"k":"line","t":"...크흠, 그래서... 제가 뭘... 도, 도와드리면 되는 걸까요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"메이드의 <bouten>봉사 정신</bouten>이 뭔지 알려줘.","n":"클레어","c":"CH0068"},{"k":"line","t":"......네?","n":"메이드장","c":"NP0799"},{"k":"line","t":"그걸 배운 뒤로 힘 조절이 잘 안되고 있거든.","n":"클레어","c":"CH0068"},{"k":"line","t":"내가 뭔가 잘못 알고 있는 것 같아서, 너한테 배우러 온 거야.","n":"클레어","c":"CH0068"},{"k":"line","t":"음... 봉사 정신이라고 해도 너무 갑작스러운데...","n":"메이드장","c":"NP0799"},{"k":"line","t":"해결사가 그랬어. 가장 중요한 건 마음이라고.","n":"클레어","c":"CH0068"},{"k":"line","t":"그리고 그 마음은 메이드의 봉사 정신이랑 비슷하다고 했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"메이드가 주인을 위하는 것처럼, 누군가를 위하는 마음이 중요하대.","n":"클레어","c":"CH0068"},{"k":"line","t":"그런데 나는 그게 잘 안되는 것 같아.","n":"클레어","c":"CH0068"},{"k":"line","t":"...잘 안된다 하심은?","n":"메이드장","c":"NP0799"},{"k":"line","t":"...음. 해결사가 나를 위해 해줬을 때, 나는 엄청 좋았어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그런데 내가 해결사를 위해 해줬을 때는, 해결사가 좋아하지 않았어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그러니까 나한테 뭔가 문제가 있는 것 같은데, 그게 뭔지 모르겠어.","n":"클레어","c":"CH0068"},{"k":"line","t":"딱히 에너지가 부족한 것도 아닌데 말이야.","n":"클레어","c":"CH0068"},{"k":"line","t":"에, 에너지...?","n":"메이드장","c":"NP0799"},{"k":"line","t":"으음... 잘은 모르겠지만, 제가 보기엔 클레어 님한테 문제가 있는 것 같진 않아요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"다른 분한테 했을 때는 괜찮았다고 하셨잖아요?","n":"메이드장","c":"NP0799"},{"k":"line","t":"......음. 그렇네.","n":"클레어","c":"CH0068"},{"k":"line","t":"그럼 주인님께 문제가 있냐 하면, 그것도 아닐 테고요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"전에 주인님과 그... 해, 했을 때는 문제가 없었다고 하셨으니까요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"그렇다면 문제는... 아니, 문제라기보다는 생각해 볼만한 점이라고 할까요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"클레어 님이 봉사 정신을 배운 이후,\n뭐가 달라졌는지예요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"달라진 거?","n":"클레어","c":"CH0068"},{"k":"line","t":"네. 그런 건 보통 자기도 몰랐던 경우가 많고, 알아채기도 힘든 법이거든요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"그러니까 주인님이 아니라, 클레어 님의 마음을 잘 들여다봐야 해요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"내가 하고 싶은 건 뭔지, 하고 싶지 않은 건 뭔지... 이런 것들 말이에요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"......음. 그렇구나.","n":"클레어","c":"CH0068"},{"k":"line","t":"그럼 말인데...","n":"클레어","c":"CH0068"},{"k":"line","t":"......응. 알겠어.","n":"클레어","c":"CH0068"},{"k":"line","t":"궁금한 건 다 해결되셨나요?","n":"메이드장","c":"NP0799"},{"k":"line","t":"...음. 어느 정도는.","n":"클레어","c":"CH0068"},{"k":"line","t":"그럼 나 갈게. 고마워. 엄청 도움 됐어.","n":"클레어","c":"CH0068"},{"k":"line","t":"후훗, 별말씀을요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"...후후, 부럽네요...","n":"메이드장","c":"NP0799"},{"k":"line","t":"자, 그럼 남은 일이나 할까요.","n":"메이드장","c":"NP0799"},{"k":"line","t":"근데 말이야.","n":"클레어","c":"CH0068"},{"k":"line","t":"네, 넷!!?","n":"메이드장","c":"NP0799"},{"k":"line","t":"너도 하고 싶은 게 있는 거 아니야?","n":"클레어","c":"CH0068"},{"k":"line","t":"그냥 네 얘기를 듣다 보니 그런 생각이 들어서.","n":"클레어","c":"CH0068"},{"k":"line","t":"그게 뭔지는 모르겠지만, 자기 마음을 잘 들여다보라고 말해준 건 너니까.","n":"클레어","c":"CH0068"},{"k":"line","t":"그럼, 안녕.","n":"클레어","c":"CH0068"},{"k":"line","t":"제가 하고 싶은 것...","n":"메이드장","c":"NP0799"}]}]},"6820":{"chat":[{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"오늘 밤에 괜찮아?","n":"클레어","c":"CH0068"},{"k":"reply","o":["뭐야, 한동안 조용하더니"]},{"k":"reply","o":["이번에는 확실해?"]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"모르겠어","n":"클레어","c":"CH0068"},{"k":"msg","t":"그래도 괜찮을 것 같아","n":"클레어","c":"CH0068"},{"k":"reply","o":["흠"]},{"k":"reply","o":["뭐 그렇다면야"]},{"k":"msg","t":"응","n":"클레어","c":"CH0068"},{"k":"msg","t":"이따봐","n":"클레어","c":"CH0068"},{"k":"story"},{"k":"msg","t":"안녕 해결사","n":"클레어","c":"CH0068"},{"k":"msg","t":"오늘도 해줄까?","n":"클레어","c":"CH0068"},{"k":"msg","t":"아니면 네가 해주는 것도 좋은데","n":"클레어","c":"CH0068"},{"k":"reply","o":["또 하자고?"]},{"k":"reply","o":["아니 벌써 연속으로 며칠째야"]},{"k":"reply","o":["나도 좀 쉬자 나도 사람이야 사람"]},{"k":"msg","t":"음","n":"클레어","c":"CH0068"},{"k":"msg","t":"그럼 내가 해줄 테니까 해결사는 아무것도 안 해도 돼","n":"클레어","c":"CH0068"},{"k":"msg","t":"그냥 가만히 누워있기만 하면 내가 알아서 다 할게","n":"클레어","c":"CH0068"},{"k":"msg","t":"해결사?","n":"클레어","c":"CH0068"},{"k":"reply","o":["메시지 전송에 실패했습니다."]},{"k":"msg","t":"두 번은 안 통해","n":"클레어","c":"CH0068"},{"k":"reply","o":["아"]}],"story":[{"k":"text","lines":[{"k":"place","t":"리조트 객실"},{"k":"line","t":"안녕 해결사.","n":"클레어","c":"CH0068"},{"k":"line","t":"오늘도 일하느라 고생 많았어. 힘들었지?","n":"클레어","c":"CH0068"},{"k":"line","t":"......? 어, 어어. 그, 그래.","n":"나"},{"k":"line","t":"땀을 많이 흘렸네. 힘들었겠다.","n":"클레어","c":"CH0068"},{"k":"line","t":"그럼, 목욕부터 할래?","n":"클레어","c":"CH0068"},{"k":"line","t":"어? 아, 아니...?","n":"나"},{"k":"line","t":"......음.","n":"클레어","c":"CH0068"},{"k":"line","t":"아니, 목욕부터 해야 해.","n":"클레어","c":"CH0068"},{"k":"line","t":"뭐, 뭔데. 무슨 속셈인데.","n":"나"},{"k":"line","t":"속셈은 없어.","n":"클레어","c":"CH0068"},{"k":"line","t":"근데 목욕부터 해야 해.","n":"클레어","c":"CH0068"},{"k":"line","t":"(아니 누가 봐도 속셈 가득한 말이잖아...)","n":"나"},{"k":"line","t":"에휴... 그래, 해라. 하면 되잖아.","n":"나"},{"k":"line","t":"그럼 마사지 연습은 목욕 끝나고 하는 거냐?","n":"나"},{"k":"line","t":"아니. 네가 목욕하는 동안 할 거야.","n":"클레어","c":"CH0068"},{"k":"line","t":"......","n":"나"},{"k":"line","t":"...엉? 그게 뭔 소리냐?","n":"나"},{"k":"line","t":"목욕하는 동안 할 거야.","n":"클레어","c":"CH0068"},{"k":"line","t":"아니... 그건 그냥 똑같은 말이잖아!","n":"나"},{"k":"line","t":"그러니까, 내가 목욕하는 동안 마사지 연습을 하겠다고?","n":"나"},{"k":"line","t":"응.","n":"클레어","c":"CH0068"},{"k":"line","t":"서, 설마...","n":"나"},{"k":"line","t":"다 준비해 놨어. 해결사는 몸만 오면 돼.","n":"클레어","c":"CH0068"},{"k":"line","t":"자, 잠깐! 혹시 모르니까 미리 메딕을―","n":"나"},{"k":"line","t":"그런 거 필요 없어.","n":"클레어","c":"CH0068"},{"k":"line","t":"이번엔 정말 자신 있으니까.","n":"클레어","c":"CH0068"}]},{"k":"scene","kind":"affection"},{"k":"text","lines":[{"k":"narration","t":"그 후, 한동안 클레어에게 엉망진창 빨렸다."},{"k":"narration","t":"그리고..."},{"k":"place","t":"모래사장"},{"k":"line","t":"......음.","n":"클레어","c":"CH0068"},{"k":"line","t":"바닷바람이 시원해. 기분 좋아.","n":"클레어","c":"CH0068"},{"k":"line","t":"나는 죽을 맛이다만...","n":"나"},{"k":"line","t":"...음. 혹시 나랑 한 거 별로였어?","n":"클레어","c":"CH0068"},{"k":"line","t":"별로라는 건 아닌데... 원래 하고 나면 피곤해지는 법이라고.","n":"나"},{"k":"line","t":"나는 안 그랬는데. 원래 그런 거야?","n":"클레어","c":"CH0068"},{"k":"line","t":"몰라. 넌 호문쿨루스라 그런 거 아니냐?","n":"나"},{"k":"line","t":"......해결사, 호문쿨루스도 평범한 사람이야.","n":"클레어","c":"CH0068"},{"k":"line","t":"네가 그런 말을 하는 거냐?! 지금까지 한 짓을 생각해 보라고!!","n":"나"},{"k":"line","t":"...에휴, 뭐 어쨌든...","n":"나"},{"k":"line","t":"이번에 한 건 그럭저럭 합격점이다. 그렇다고 너무 기고만장하진 말고.","n":"나"},{"k":"line","t":"아직 부족한 게 많으니까, 앞으로도 계속 정진하도록.","n":"나"},{"k":"line","t":"응.","n":"클레어","c":"CH0068"},{"k":"line","t":"아무튼, 그래서 뭘 했길래 갑자기 깨달음을 얻은 거냐?","n":"나"},{"k":"line","t":"내가 <bouten>하고 싶은 걸</bouten> 했어.","n":"클레어","c":"CH0068"},{"k":"line","t":"......엉? 하고 싶은 거?","n":"나"},{"k":"line","t":"전에는 널 위해서 해야 한다고 생각했거든.","n":"클레어","c":"CH0068"},{"k":"line","t":"메이드는 자기를 위해서 봉사하는 게 아니라 주인을 위해서 봉사하잖아.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래서 나도 그렇게 했었어.","n":"클레어","c":"CH0068"},{"k":"line","t":"아니 뭐... 그걸 꼭 그렇게 생각할 필요는 없지 않냐?","n":"나"},{"k":"line","t":"그 봉사하는 메이드도 자기가 좋으니까 봉사하는 거겠지.","n":"나"},{"k":"line","t":"응. 처음에는 그걸 몰랐어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그래서 자꾸 다른 생각이 들 때마다 힘이 들어갔던 거야.","n":"클레어","c":"CH0068"},{"k":"line","t":"널 위해서 해야 한다고 생각하다 보니까 힘 조절이 안 된 거였어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그, 그래... 참고로 다른 생각이라면, 뭔 생각을 했는데...?","n":"나"},{"k":"line","t":"비밀이야.","n":"클레어","c":"CH0068"},{"k":"line","t":"......엉?","n":"나"},{"k":"line","t":"아니, 그게 왜 비밀인데. 이쯤 되면 말해줄 때도 됐잖아.","n":"나"},{"k":"line","t":"아직 말할 수 없어.","n":"클레어","c":"CH0068"},{"k":"line","t":"그럼 언제 말해줄 건데.","n":"나"},{"k":"line","t":"내가 몸의 대화를 완벽하게 익힐 때까지?","n":"클레어","c":"CH0068"},{"k":"line","t":"...잠깐, 이 짓을 계속하겠다고?","n":"나"},{"k":"line","t":"응. 아직 부족한 게 많으니까, 계속 정진하라고 한 건 너잖아.","n":"클레어","c":"CH0068"},{"k":"line","t":"아.","n":"나"},{"k":"line","t":"그러니까, 이 여름이 끝나고 나서도...","n":"클레어","c":"CH0068"},{"k":"line","t":"잘 부탁해, 해결사.","n":"클레어","c":"CH0068"}]}]}}}
