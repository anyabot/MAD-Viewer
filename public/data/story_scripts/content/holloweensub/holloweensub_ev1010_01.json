n":"right","Lazy":"0"}},{"class":"HighlightCommand","line":220,"indent":1,"fields":{"ActorIds":"danhee"}},{"class":"CharacterEmoticonCommand","line":221,"indent":1,"fields":{"IdAndEmoticon":"danhee.chaos","Wait":"false","Volume":"1.0","Lazy":"0"}},{"class":"Wait","line":222,"indent":1,"fields":{"WaitMode":"0.3"}},{"class":"HighlightCommand","line":223,"indent":1,"fields":{"ActorIds":"auto"}},{"class":"PrintText","line":224,"indent":1,"fields":{"Text":"","AuthorId":"danhee","RevealSpeed":"1.0","Wait":"1"},"text":"으음... 부정한 힘에 때문인지 내 힘이 통하지 않는구나.","texts":{"en":"Hmm... Brute force isn't working on them. It must be the corrupting power.","ja":"うむ……不浄な力のせいか、我の力が通じぬな。","zh-Hans":"唔嗯……不知是不是因为污秽之力的缘故，我的力量不起作用呢。","zh-Hant":"嗯……不知是否因為污穢之力的緣故，我的力量起不了作用呢。","th":"อืม... อาจเป็นเพราะพลังแปดเปื้อน พลังของข้าถึงใช้ไม่ได้ผลเลยสินะ","es":"Mmm... Debe de ser por culpa del poder corruptor, pero mi fuerza no surte efecto."},"author":"danhee"},{"class":"ModifyCharacter","line":225,"indent":1,"fields":{"Duration":"0.2","Wait":"false","IdAndAppearance":"danhee","LookDirection":"left","Lazy":"0"}},{"class":"CharacterMoveCommand","line":226,"indent":1,"fields":{"IdAndAppearance":"danhee","Wait":"true","Destination":",,-8","Duration":"0.35","Lazy":"0"}},{"class":"ModifyCamera","line":227,"indent":1,"fields":{"Offset":"-2.5,2.2","Zoom":"0.22","Duration":"0.4","Wait":"true","Lazy":"0"}},{"class":"PrintText","line":228,"indent":1,"fields":{"Text":"","AuthorId":"danhee","RevealSpeed":"1.0","Wait":"1"},"text":"벗아, 어쩌면 좋겠느냐?","texts":{"en":"My friend, what should we do?","ja":"友よ、どうすればよいと思う？","zh-Hans":"朋友，这下该如何是好？","zh-Hant":"朋友啊，這下該如何是好？","th":"สหายเอ๋ย จะเอาอย่างไรดีล่ะ?","es":"Camarada, ¿qué deberíamos hacer?"},"author":"danhee"},{"class":"PrintText","line":230,"indent":1,"fields":{"Text":"","AuthorId":"player","RevealSpeed":"1.0","Wait":"1"},"text":"그걸 나한테 물으면 안 되지.","texts":{"en":"Don't ask me.","ja":"それを俺に聞かれても困るんだが。","zh-Hans":"你问我我问谁啊。","zh-Hant":"這妳問我可就不對了吧。","th":"มาถามฉันแบบนั้นไม่ได้สิ","es":"No me preguntes a mí."},"author":"player"},{"class":"PrintText","line":231,"indent":1,"fields":{"Text":"","AuthorId":"player","RevealSpeed":"1.0","Wait":"1"},"text":"이렇게 되면 나가린데...","texts":{"en":"Well, we're out of luck...","ja":"これじゃあお手上げだな……","zh-Hans":"搞成这样可就泡汤了啊……","zh-Hant":"這樣一來可就泡湯了啊……","th":"ถ้าเป็นแบบนี้ก็พังไม่เป็นท่าเลยน่ะสิ...","es":"Si la cosa está así, estamos bien apañaos..."},"author":"player"},{"class":"CharacterRollCommand","line":233,"indent":1,"fields":{"IdAndAppearance":"danhee","Wait":"true","To":"0","Pivot":"0","Duration":"0.35","Lazy":"0"}},{"class":"HidePrinter","line":234,"indent":1,"fields":{}},{"class":"ModifyBackground","line":235,"indent":1,"fields":{"Duration":"0.3","Wait":"true","AppearanceAndTransition":"BG_Fade_Black","Lazy":"0"}},{"class":"ModifyTextPrinter","line":236,"indent":1,"fields":{"IdAndAppearance":"ExCenterSubtitle","Lazy":"0","MakeDefault":"1","HideOther":"1"}},{"class":"PrintText","line":237,"indent":1,"fields":{"Text":"","RevealSpeed":"1.0","Wait":"1"},"text":"아무래도 힘으로는 할 수 없는 듯 하다...","texts":{"en":"Brute force wasn't going to work...","ja":"どうやら力づくではどうにもならないようだ……","zh-Hans":"看来靠武力是行不通了……","zh-Hant":"看來光憑力量似乎是行不通的……","th":"ดูเหมือนว่าจะใช้กำลังแก้ปัญหาไม่ได้เสียแล้ว...","es":"Por lo visto, no es algo que se pueda solucionar por la fuerza..."}},{"class":"HidePrinter","line":238,"indent":1,"fields":{}},{"class":"ModifyTextPrinter","line":239,"indent":1,"fields":{"IdAndAppearance":"ExDialogue","Lazy":"0","MakeDefault":"1","HideOther":"1"}},{"class":"ModifyCamera","line":241,"indent":1,"fields":{"Offset":"0,0","Zoom":"0","Duration":"0.4","Wait":"true","Lazy":"0"}},{"class":"SetCustomVariable","line":242,"indent":1,"fields":{"Expression":"ev1010GhostResult=\"wrong\""}},{"class":"Stop","line":243,"fields":{}},{"class":"ScreenFadeCommand","line":245,"fields":{"Duration":"0.35","Wait":"false","Direction":"Out","EasingTypeName":"EaseOutQuad"}},{"class":"StopBgm","line":246,"fields":{"FadeOutDuration":"3","Wait":"fals