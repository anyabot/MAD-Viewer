# Where the viewer fetches generated JSON (skin_list.json, characters.json).
# "local" = /data/* served out of public/ ; "bucket" = NEXT_PUBLIC_DATA_BASE.
NEXT_PUBLIC_DATA_SOURCE=local
NEXT_PUBLIC_DATA_BASE=

# Packed skin archives (<skin>.tar.br) produced by tools/skin_test/pack.py.
NEXT_PUBLIC_SKIN_ARCHIVE_BASE=/skins

# Dev-only: prefer an unpacked public/skin_test/<skin>/ export over the archive.
NEXT_PUBLIC_LOCAL_SKIN_DIR=0
